<!-- Load exact Google Fonts for Return Policy Page -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400;1,500&family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

{%- style -%}
  .fm-policy-root {
    background-color: #FBF8F4;
    color: #1B4332;
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif;
    padding-top: 40px;
    padding-bottom: 96px;
    min-height: 70vh;
  }
  @media (min-width: 768px) {
    .fm-policy-root {
      padding-top: 60px;
      padding-bottom: 128px;
    }
  }

  .fm-policy-header {
    padding-top: 32px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(27, 67, 50, 0.12);
  }
  @media (min-width: 768px) {
    .fm-policy-header {
      padding-top: 48px;
      padding-bottom: 56px;
    }
  }

  .fm-policy-header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }
  @media (min-width: 768px) {
    .fm-policy-header-inner {
      padding: 0 40px;
    }
  }

  .fm-policy-eyebrow {
    font-family: 'Manrope', sans-serif !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 0.32em !important;
    text-transform: uppercase !important;
    color: #C9A24D !important;
    display: block !important;
    margin-bottom: 16px !important;
    line-height: 1.2 !important;
  }

  .fm-policy-title {
    font-family: 'Playfair Display', Georgia, Cambria, serif !important;
    font-size: 38px !important;
    line-height: 1.05 !important;
    letter-spacing: -0.02em !important;
    color: #1B4332 !important;
    margin: 0 0 16px 0 !important;
    font-weight: 400 !important;
    max-width: 800px;
  }
  @media (min-width: 768px) {
    .fm-policy-title {
      font-size: 64px !important;
    }
  }

  .fm-policy-subtitle {
    font-family: 'Manrope', sans-serif !important;
    font-size: 15px !important;
    line-height: 1.65 !important;
    color: rgba(27, 67, 50, 0.75) !important;
    max-width: 640px !important;
    margin: 0 !important;
    font-weight: 400 !important;
  }

  .fm-policy-body-sec {
    padding: 56px 0;
  }
  @media (min-width: 768px) {
    .fm-policy-body-sec {
      padding: 80px 0;
    }
  }

  .fm-policy-body-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }
  @media (min-width: 768px) {
    .fm-policy-body-inner {
      padding: 0 40px;
    }
  }

  .fm-policy-h2 {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: 26px !important;
    line-height: 1.18 !important;
    color: #1B4332 !important;
    margin-top: 56px !important;
    margin-bottom: 20px !important;
    font-weight: 400 !important;
    letter-spacing: -0.01em !important;
  }
  .fm-policy-h2:first-child {
    margin-top: 0 !important;
  }
  @media (min-width: 768px) {
    .fm-policy-h2 {
      font-size: 34px !important;
    }
  }

  .fm-policy-h3 {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: 19px !important;
    line-height: 1.25 !important;
    color: #1B4332 !important;
    margin-top: 36px !important;
    margin-bottom: 14px !important;
    font-weight: 400 !important;
  }
  @media (min-width: 768px) {
    .fm-policy-h3 {
      font-size: 22px !important;
    }
  }

  .fm-policy-p {
    font-family: 'Manrope', sans-serif !important;
    font-size: 15px !important;
    line-height: 1.75 !important;
    color: rgba(27, 67, 50, 0.80) !important;
    margin: 0 0 18px 0 !important;
    font-weight: 400 !important;
  }
  @media (min-width: 768px) {
    .fm-policy-p {
      font-size: 16px !important;
    }
  }

  .fm-policy-ul {
    list-style: disc !important;
    padding-left: 24px !important;
    margin: 0 0 24px 0 !important;
    color: #1B4332 !important;
    line-height: 1.8 !important;
    font-size: 15px !important;
  }
  @media (min-width: 768px) {
    .fm-policy-ul {
      font-size: 16px !important;
    }
  }
  .fm-policy-ul li {
    margin-bottom: 10px !important;
    color: #1B4332 !important;
  }
  .fm-policy-ul li strong {
    color: #1B4332 !important;
    font-weight: 600 !important;
  }
  .fm-policy-ul li::marker {
    color: #1B4332 !important;
  }

  .link-underline {
    color: #1B4332 !important;
    text-decoration: underline !important;
    text-underline-offset: 3px !important;
    transition: color 0.2s ease;
  }
  .link-underline:hover {
    color: #C9A24D !important;
  }
{%- endstyle -%}

<div class="fm-policy-root" data-testid="content-page-return-policy">
  <!-- Header Banner -->
  <header class="fm-policy-header">
    <div class="fm-policy-header-inner">
      <span class="fm-policy-eyebrow">Policy</span>
      <h1 class="fm-policy-title">Return Policy</h1>
      <p class="fm-policy-subtitle">How returns, exchanges, and refunds work at Farsh Mahal.</p>
    </div>
  </header>

  <!-- Body Content -->
  <section class="fm-policy-body-sec">
    <div class="fm-policy-body-inner">

      <!-- 1. Policy overview -->
      <h2 class="fm-policy-h2">Policy overview</h2>
      <p class="fm-policy-p">At Farsh Mahal, all sales are considered final. We accept returns or exchanges only if the product has a manufacturing defect that can't be fixed. Please note that any item delivered outside India is not eligible for return or refund.</p>

      <!-- 2. Reporting defects -->
      <h2 class="fm-policy-h2">Reporting defects</h2>
      <p class="fm-policy-p">
        If your product has a manufacturing defect, please tell us within 48 hours of delivery. Report issues by emailing <a href="mailto:farshmahal@gmail.com" class="link-underline">farshmahal@gmail.com</a> with images and a detailed description of the defect, along with your order number. Keep the original packaging and tags intact for the return.
      </p>

      <!-- 3. What isn't considered a defect -->
      <h2 class="fm-policy-h2">What isn't considered a defect</h2>
      <ul class="fm-policy-ul">
        <li><strong>Shedding:</strong> New hand-tufted rugs commonly shed loose fibres — a natural process that reduces with routine vacuuming on a low-power setting once or twice a week.</li>
        <li><strong>Fibre sprouting:</strong> Individual tufts sometimes rise above the surface. This is normal — clip them level with scissors rather than pulling.</li>
        <li><strong>Creasing or rolling marks:</strong> Rugs shipped rolled or folded may show creases that generally flatten within a few days. Rolling in the opposite direction can help.</li>
        <li><strong>Scent:</strong> New rugs may have a slight smell from packing materials; it usually dissipates within 24 hours in a well-ventilated area or in sunlight.</li>
        <li><strong>Colour variance:</strong> Screens and lighting affect how colour appears. We work to represent our rugs accurately but can't guarantee an exact match to your display.</li>
      </ul>

      <!-- 4. Resolution -->
      <h2 class="fm-policy-h2">Resolution</h2>
      <p class="fm-policy-p">Once we confirm that an issue falls under our policy, we'll offer the most appropriate resolution — repair, replacement, or another suitable outcome.</p>

      <h3 class="fm-policy-h3">Refund of shipping cost</h3>
      <p class="fm-policy-p">Where a defect is confirmed, we refund the cost of return shipping within ten days of receiving the returned item, via your original payment method.</p>

      <h3 class="fm-policy-h3">Product replacement</h3>
      <p class="fm-policy-p">Alongside the shipping refund, we replace the defective product with an identical new item, wherever available.</p>

      <!-- 5. Important notes -->
      <h2 class="fm-policy-h2">Important notes</h2>
      <ul class="fm-policy-ul">
        <li><strong>International orders:</strong> Any item delivered outside India is not eligible for return or refund.</li>
        <li><strong>Intact tags and packaging:</strong> Original tags and packaging must be intact for a successful return.</li>
        <li><strong>Timing matters:</strong> Delays in notification or return dispatch may result in rejection of the request.</li>
        <li>Farsh Mahal reserves the right to refuse returns or exchanges that do not meet these conditions. Non-qualifying items will be sent back at the customer's expense and a refund will not be issued.</li>
        <li><strong>Made-to-order & custom:</strong> Eligible for cancellation and a full refund within 24 hours of purchase. After that window, production begins and cancellation is no longer possible.</li>
      </ul>

    </div>
  </section>
</div>
