{%- comment -%}
  Determine which article to render based on article_handle, article.handle, or page.handle
{%- endcomment -%}
{%- assign current_handle = article_handle | default: article.handle | default: page.handle | default: 'rug-size-guide' -%}

{%- case current_handle -%}
  {%- when 'understanding-hand-tufted-rugs', 'hand-tufted-explained' -%}
    {%- assign a_cat = "Craft" -%}
    {%- assign a_title = "Understanding Hand-Tufted Rugs" -%}
    {%- assign a_hero = "https://images.unsplash.com/photo-1638310533874-6c124c012e1d?crop=entropy&cs=srgb&fm=jpg&w=2400&q=85" -%}
    {%- assign a_author = "Priya Sharma" -%}
    {%- assign a_date = "December 28, 2025" -%}
    {%- assign a_read = "8 min read" -%}
    {%- assign a_key = "hand-tufted" -%}

  {%- when 'layering-rugs-like-an-interior-designer', 'layering-rugs' -%}
    {%- assign a_cat = "Styling" -%}
    {%- assign a_title = "Layering Rugs Like an Interior Designer" -%}
    {%- assign a_hero = "https://images.unsplash.com/photo-1628744876497-eb30460be9f6?crop=entropy&cs=srgb&fm=jpg&w=2400&q=85" -%}
    {%- assign a_author = "Marcus Levine" -%}
    {%- assign a_date = "December 15, 2025" -%}
    {%- assign a_read = "5 min read" -%}
    {%- assign a_key = "layering" -%}

  {%- when 'color-trends-for-modern-interiors', 'color-trends' -%}
    {%- assign a_cat = "Design Trends" -%}
    {%- assign a_title = "Color Trends for Modern Interiors" -%}
    {%- assign a_hero = "https://images.unsplash.com/photo-1557374669-d1f478dc92c4?crop=entropy&cs=srgb&fm=jpg&w=2400&q=85" -%}
    {%- assign a_author = "The Farsh Mahal Team" -%}
    {%- assign a_date = "November 30, 2025" -%}
    {%- assign a_read = "4 min read" -%}
    {%- assign a_key = "color-trends" -%}

  {%- when 'the-beauty-of-texture-in-interior-design', 'beauty-of-texture' -%}
    {%- assign a_cat = "Design Trends" -%}
    {%- assign a_title = "The Beauty of Texture in Interior Design" -%}
    {%- assign a_hero = "https://images.unsplash.com/photo-1745589720030-c32f81367a57?crop=entropy&cs=srgb&fm=jpg&w=2400&q=85" -%}
    {%- assign a_author = "The Farsh Mahal Team" -%}
    {%- assign a_date = "November 12, 2025" -%}
    {%- assign a_read = "4 min read" -%}
    {%- assign a_key = "texture" -%}

  {%- else -%}
    {%- assign a_cat = "Buying Guide" -%}
    {%- assign a_title = article.title | default: "How to Choose the Perfect Rug Size for Every Room" -%}
    {%- assign a_hero = "https://images.unsplash.com/photo-1615800002234-05c4d488696c?crop=entropy&cs=srgb&fm=jpg&w=2400&q=85" -%}
    {%- assign a_author = article.author | default: "The Farsh Mahal Team" -%}
    {%- assign a_date = "January 12, 2026" -%}
    {%- assign a_read = "6 min read" -%}
    {%- assign a_key = "size-guide" -%}
{%- endcase -%}

{%- if article.image -%}
  {%- assign a_hero = article.image | image_url: width: 2400 -%}
{%- endif -%}

