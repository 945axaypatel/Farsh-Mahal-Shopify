  <div class="fm-art-view" id="ArtView-hand-tufted-explained">
    <section class="fm-art-hero-wrap">
      <div class="fm-art-hero-bg">
        <img src="https://images.unsplash.com/photo-1638310533874-6c124c012e1d?crop=entropy&cs=srgb&fm=jpg&w=2400&q=85" alt="Understanding Hand-Tufted Rugs" class="fm-art-hero-img" loading="eager">
