<script>
  (function() {
    window.fmShowArticle = function(handle) {
      var mainView = document.getElementById('FarshJournalMainView');
      var allArtViews = document.querySelectorAll('.fm-art-view');
      
      if (mainView) mainView.style.display = 'none';
      allArtViews.forEach(function(v) { v.style.display = 'none'; });

      var target = document.getElementById('ArtView-' + handle);
      if (target) {
        target.style.display = 'block';
        window.scrollTo({ top: 0, behavior: 'smooth' });
        try {
          var newUrl = window.location.pathname + '?article=' + handle;
          window.history.pushState({ article: handle }, '', newUrl);
        } catch (e) {}
      }
    };

    window.fmShowJournalMain = function() {
      var mainView = document.getElementById('FarshJournalMainView');
      var allArtViews = document.querySelectorAll('.fm-art-view');
      
      allArtViews.forEach(function(v) { v.style.display = 'none'; });
      if (mainView) mainView.style.display = 'block';
      window.scrollTo({ top: 0, behavior: 'smooth' });
      try {
        window.history.pushState({}, '', window.location.pathname);
      } catch (e) {}
    };

    document.addEventListener('DOMContentLoaded', function() {
      // 1. Tab filters
      var tabs = document.querySelectorAll('.fm-jnl-tab-btn');
      var items = document.querySelectorAll('.fm-jnl-card-item');
      var featured = document.getElementById('JournalFeaturedStory');

      tabs.forEach(function(btn) {
        btn.addEventListener('click', function() {
          tabs.forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');

          var filter = btn.getAttribute('data-filter');

          if (featured) {
            if (filter === 'all' || (featured.getAttribute('data-category') || '').includes(filter)) {
              featured.style.display = 'block';
            } else {
              featured.style.display = 'none';
            }
          }

          items.forEach(function(item) {
            var cat = item.getAttribute('data-category') || '';
            if (filter === 'all' || cat.includes(filter)) {
              item.style.display = 'block';
            } else {
              item.style.display = 'none';
            }
          });
        });
      });

      // 2. Check URL parameters for direct article load
      var urlParams = new URLSearchParams(window.location.search);
      var artParam = urlParams.get('article');
      if (artParam) {
        window.fmShowArticle(artParam);
      } else if (window.location.hash) {
        var h = window.location.hash.replace('#', '');
        if (h && document.getElementById('ArtView-' + h)) {
          window.fmShowArticle(h);
        }
      }

      // Handle browser back/forward buttons
      window.addEventListener('popstate', function(e) {
        if (e.state && e.state.article) {
          window.fmShowArticle(e.state.article);
        } else {
          window.fmShowJournalMain();
        }
      });
    });
  })();
</script>
