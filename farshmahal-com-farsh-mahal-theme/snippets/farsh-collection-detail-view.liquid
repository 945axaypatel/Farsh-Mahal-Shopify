    var heroImg = document.getElementById('cdHeroFallbackImg');
    if (heroImg && collectionHeroImages[currentHandle]) {
      heroImg.src = collectionHeroImages[currentHandle];
    }

    var descEl = document.getElementById('cdFallbackDesc');
    if (descEl && collectionDescriptions[currentHandle]) {
      descEl.textContent = collectionDescriptions[currentHandle];
    }

    var grid = document.getElementById('cdProductGrid');
    var countEl = document.getElementById('cdProductCountDisplay');

    // If Shopify collection has 0 products or we want exact matching products:
    var currentGridCount = grid ? grid.querySelectorAll('.fm-cd-card').length : 0;
    if (currentGridCount === 0 && grid) {
      var matchingProducts = defaultProducts.filter(function(p) {
        var tLower = (p.title || '').toLowerCase();
        var sLower = (p.series || '').toLowerCase();
        var hLower = (p.handle || '').toLowerCase();
        var colQuery = (currentHandle || '').toLowerCase();
        
        var directMatch = sLower.indexOf(colQuery.replace(/-/g, ' ')) !== -1 || colQuery.indexOf(sLower.replace(/ /g, '-')) !== -1;
        if (directMatch) return true;

        if (collectionLookup[colQuery]) {
          return collectionLookup[colQuery].some(function(term) {
            return tLower.indexOf(term) !== -1 || hLower.indexOf(term.replace(/\s+/g, '-')) !== -1;
          });
        }
        return false;
      });

      if (matchingProducts.length === 0) {
        matchingProducts = defaultProducts.slice(0, 8);
      }

      if (countEl) {
        countEl.textContent = matchingProducts.length + ' pieces';
      }

      var html = '';
      matchingProducts.forEach(function(item, idx) {
        var formattedPrice = '$' + (typeof item.price === 'number' ? item.price.toLocaleString('en-US') : item.price);
        var hoverImgHtml = (item.image2 && item.image2 !== item.image) 
          ? '<img src="' + item.image2 + '" alt="' + item.title + '" class="fm-cd-card-img fm-cd-card-img-hover" loading="lazy">' 
          : '';

        html += '<a href="' + item.url + '" class="fm-cd-card">' +
                  '<div class="fm-cd-card-media">' +
                    '<img src="' + item.image + '" alt="' + item.title + '" class="fm-cd-card-img fm-cd-card-img-primary" loading="lazy">' +
                    hoverImgHtml +
                    (idx === 0 ? '<span class="fm-cd-badge-new">NEW</span>' : '') +
                  '</div>' +
                  '<div class="fm-cd-card-info">' +
                    '<div>' +
                      '<h3 class="fm-cd-card-title">' + item.title + '</h3>' +
                      '<span class="fm-cd-card-series">' + (item.series || currentTitle) + '</span>' +
                    '</div>' +
                    '<div class="fm-cd-card-price">' + formattedPrice + '</div>' +
                  '</div>' +
                '</a>';
      });

      grid.innerHTML = html;
    }
  })();
</script>

