  Farsh Mahal Individual Collection Detail Subpage Section
  Matches https://farshmahal.com/collections/:handle (chunk 958) 100%
{%- endcomment -%}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap" rel="stylesheet">

{%- style -%}
  .fm-cd-page {
    background-color: #FBF8F4;
    color: #1B4332;
    overflow-x: hidden;
    padding-top: 0;
  }

  /* Hero Banner */
  .fm-cd-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    background-color: #F7F4EE;
    overflow: hidden;
  }

  .fm-cd-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .fm-cd-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    animation: fmKenBurns 18s ease-out infinite alternate;
  }

  @keyframes fmKenBurns {
    0% { transform: scale(1.0); }
    100% { transform: scale(1.08); }
  }

  .fm-cd-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, #FBF8F4 0%, rgba(251, 248, 244, 0.75) 45%, rgba(251, 248, 244, 0.2) 80%, transparent 100%);
    z-index: 2;
  }

  .fm-cd-hero-content {
    position: relative;
    z-index: 10;
    max-width: 1400px;
    margin: 0 auto;
    padding: 140px 24px 64px 24px;
    width: 100%;
    box-sizing: border-box;
  }
  @media screen and (min-width: 768px) {
    .fm-cd-hero-content {
      padding: 180px 40px 96px 40px;
    }
  }

  .fm-cd-back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Manrope', sans-serif !important;
    font-size: 12px !important;
    letter-spacing: 0.24em !important;
    text-transform: uppercase !important;
    color: #1B4332 !important;
    text-decoration: none !important;
    margin-bottom: 32px;
    transition: all 0.25s ease;
    border-bottom: 1px solid transparent;
  }
  .fm-cd-back-link:hover {
    color: #C9A24D !important;
    border-bottom-color: #C9A24D;
    gap: 12px;
  }

  .fm-cd-eyebrow {
    font-family: 'Manrope', sans-serif !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 0.32em !important;
    text-transform: uppercase !important;
    color: #C9A24D !important;
    margin-bottom: 12px;
    display: block;
  }

  .fm-cd-title {
    font-family: 'Playfair Display', serif !important;
    font-size: 42px !important;
    line-height: 1.02 !important;
    letter-spacing: -0.02em !important;
    color: #1B4332 !important;
    margin: 0 0 16px 0 !important;
    font-weight: 400 !important;
  }
  @media screen and (min-width: 768px) {
    .fm-cd-title {
      font-size: 80px !important;
    }
  }

  .fm-cd-subtitle {
    font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif !important;
    font-style: italic !important;
    font-size: 20px !important;
    color: #C9A24D !important;
    margin: 0 0 20px 0 !important;
    line-height: 1.3 !important;
    font-weight: 400 !important;
  }
  @media screen and (min-width: 768px) {
    .fm-cd-subtitle {
      font-size: 26px !important;
    }
  }

  .fm-cd-desc {
    font-family: 'Manrope', sans-serif !important;
    font-size: 15px !important;
    line-height: 1.7 !important;
    color: rgba(27, 67, 50, 0.85) !important;
    max-width: 680px;
    margin: 0 !important;
  }

  /* Products Section */
  .fm-cd-products-section {
    padding: 80px 24px;
    max-width: 1400px;
    margin: 0 auto;
    box-sizing: border-box;
  }
  @media screen and (min-width: 768px) {
    .fm-cd-products-section {
      padding: 112px 40px;
    }
  }

  .fm-cd-header-row {
    margin-bottom: 48px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .fm-cd-count-heading {
    font-family: 'Playfair Display', serif !important;
    font-size: 28px !important;
    color: #1B4332 !important;
    margin: 12px 0 0 0 !important;
    font-weight: 400 !important;
  }
  @media screen and (min-width: 768px) {
    .fm-cd-count-heading {
      font-size: 38px !important;
    }
  }

  /* 4 Column Product Grid */
  .fm-cd-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }}
  @media screen and (min-width: 768px) {
    .fm-cd-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 36px;
    }
  }
  @media screen and (min-width: 1024px) {
    .fm-cd-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 40px;
    }
  }

  /* Card */
  .fm-cd-card {
    display: flex;
    flex-direction: column;
    text-decoration: none !important;
    position: relative;
  }

  .fm-cd-card-media {
    position: relative;
    aspect-ratio: 4 / 5;
    background-color: #EDE8DE;
    overflow: hidden;
    margin-bottom: 14px;
    display: block;
    width: 100%;
  }

  .fm-cd-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .fm-cd-card-img-primary {
    opacity: 1;
    z-index: 1;
  }

  .fm-cd-card-img-hover {
    opacity: 0;
    z-index: 2;
  }

  .fm-cd-card:hover .fm-cd-card-img-primary {
    transform: scale(1.04);
  }

  .fm-cd-card:hover .fm-cd-card-img-hover {
    opacity: 1;
    transform: scale(1.04);
  }

  .fm-cd-badge-new {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    font-family: 'Manrope', sans-serif !important;
    font-size: 10px !important;
    letter-spacing: 0.24em !important;
    text-transform: uppercase !important;
    background: #C9A24D;
    color: #1B4332;
    padding: 3px 10px;
    font-weight: 700;
    display: inline-block;
  }

  .fm-cd-card-info {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .fm-cd-card-title {
    font-family: 'Playfair Display', ui-serif, Georgia, serif !important;
    font-size: 17px !important;
    line-height: 1.2 !important;
    color: #1B4332 !important;
    font-weight: 400 !important;
    margin: 0 !important;
    transition: color 0.2s ease;
  }
  .fm-cd-card:hover .fm-cd-card-title {
    color: #C9A24D !important;
  }

  .fm-cd-card-series {
    font-family: 'Manrope', sans-serif !important;
    font-size: 10px !important;
    letter-spacing: 0.24em !important;
    text-transform: uppercase !important;
    color: #C9A24D !important;
    font-weight: 600 !important;
    margin-top: 4px !important;
    line-height: 1.2 !important;
    display: block;
  }

  .fm-cd-card-price {
    font-family: 'Playfair Display', serif !important;
    font-size: 15px !important;
    color: #1B4332 !important;
    font-weight: 400 !important;
    white-space: nowrap;
    margin: 0;
    flex-shrink: 0;
  }

  /* Explore More Bottom Banner */
  .fm-cd-explore-banner {
    border-top: 1px solid rgba(27, 67, 50, 0.12);
    padding: 96px 24px;
    background-color: #F7F4EE;
    text-align: center;
  }
  @media screen and (min-width: 768px) {
    .fm-cd-explore-banner {
      padding: 128px 24px;
    }
  }

  .fm-cd-explore-title {
    font-family: 'Playfair Display', serif !important;
    font-size: 30px !important;
    line-height: 1.05 !important;
    color: #1B4332 !important;
    margin: 16px auto 0 auto !important;
    font-weight: 400 !important;
  }
  @media screen and (min-width: 768px) {
    .fm-cd-explore-title {
      font-size: 46px !important;
    }
  }

  .fm-cd-explore-title span {
    font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif !important;
    font-style: italic !important;
    font-weight: 400 !important;
    font-size: 1.02em !important;
    color: inherit !important;
    display: inline !important;
  }

  .fm-cd-explore-btn {
    margin-top: 32px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 1px solid #1B4332;
    padding: 16px 32px;
    text-transform: uppercase;
    font-family: 'Manrope', sans-serif !important;
    font-size: 12px !important;
    letter-spacing: 0.24em !important;
    color: #1B4332 !important;
    text-decoration: none !important;
    background: transparent;
    transition: all 0.25s ease;
    font-weight: 600;
  }
  .fm-cd-explore-btn:hover {
    background: #1B4332 !important;
    color: #FBF8F4 !important;
  }
{%- endstyle -%}

{%- assign cur_handle = collection.handle -%}
{%- assign coll_subtitles = "organic-terrain:Nature, Reimagined.|modern-grid:Structure Meets Simplicity.|retro-geometry:Bold Shapes. Timeless Character.|nordic-calm:Quiet Luxury.|texture-max:Texture as Design." | split: "|" -%}}
{%- assign coll_subtitle = "" -%}
{%- for item in coll_subtitles -%}
  {%- assign parts = item | split: ":" -%}
  {%- if parts[0] == cur_handle -%}
    {%- assign coll_subtitle = parts[1] -%}
  {%- endif -%}
{%- endfor -%}

{%- assign hero_bg_img = collection.image | default: collection.featured_image -%}

<div class="fm-cd-page" data-testid="collection-detail-{{ collection.handle }}">
  <!-- Hero Section -->
  <section class="fm-cd-hero">
    <div class="fm-cd-hero-bg">
      {%- if hero_bg_img != blank -%}
        <img src="{{ hero_bg_img | image_url: width: 2400 }}" alt="{{ collection.title | escape }}" class="fm-cd-hero-img" loading="eager">
      {%- else -%}
        <img id="cdHeroFallbackImg" src="https://images.unsplash.com/photo-1628744876497-eb30460be9f6?crop=entropy&cs=srgb&fm=jpg&w=2000&q=80" alt="{{ collection.title | escape }}" class="fm-cd-hero-img" loading="eager">
      {%- endif -%}
    </div>
    <div class="fm-cd-hero-overlay"></div>

    <div class="fm-cd-hero-content">
      <a href="/collections" class="fm-cd-back-link" data-testid="back-to-collections">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        All Collections
      </a>
      <span class="fm-cd-eyebrow">Collection</span>
      <h1 class="fm-cd-title">{{ collection.title | default: 'Organic Terrain' }}</h1>
      {%- if coll_subtitle != blank -%}
        <p class="fm-cd-subtitle">{{ coll_subtitle }}</p>
      {%- endif -%}
      {%- if collection.description != blank -%}
        <p class="fm-cd-desc">{{ collection.description | strip_html }}</p>
      {%- else -%}
        <p class="fm-cd-desc" id="cdFallbackDesc">Thoughtfully designed hand-tufted rugs for modern American homes. Inspired by timeless aesthetics and natural forms.</p>
      {%- endif -%}
    </div>
  </section>

  <!-- Products Section -->
  <section class="fm-cd-products-section">
    <div class="fm-cd-header-row">
      <div>
        <span class="fm-cd-eyebrow">Rugs in this collection</span>
        <h2 class="fm-cd-count-heading" id="cdProductCountDisplay">{{ collection.products_count | default: 0 }} pieces</h2>
      </div>
    </div>

    <!-- Product Grid Container -->
    <div class="fm-cd-grid" id="cdProductGrid">
      {%- if collection.products.size > 0 -%}
        {%- for prod in collection.products -%}
          <a href="{{ prod.url }}" class="fm-cd-card">
            <div class="fm-cd-card-media">
              {%- if prod.featured_image != blank -%}
                <img src="{{ prod.featured_image | image_url: width: 1000 }}" alt="{{ prod.title | escape }}" class="fm-cd-card-img fm-cd-card-img-primary" loading="lazy">
              {%- endif -%}
              {%- if prod.images.size > 1 -%}
                <img src="{{ prod.images[1] | image_url: width: 1000 }}" alt="{{ prod.title | escape }}" class="fm-cd-card-img fm-cd-card-img-hover" loading="lazy">
              {%- endif -%}
              {%- if forloop.first -%}
                <span class="fm-cd-badge-new">NEW</span>
              {%- endif -%}
            </div>
            <div class="fm-cd-card-info">
              <div>
                <h3 class="fm-cd-card-title">{{ prod.title }}</h3>
                <span class="fm-cd-card-series">{{ collection.title }}</span>
              </div>
              <div class="fm-cd-card-price">{{ prod.price | money_without_trailing_zeros }}</div>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </section>

  <!-- Explore More Banner -->
  <section class="fm-cd-explore-banner">
    <span class="fm-cd-eyebrow">Explore more</span>
    <h2 class="fm-cd-explore-title">
      Discover our other <span>collections.</span>
    </h2>
    <div>
      <a href="/collections" class="fm-cd-explore-btn" data-testid="collection-detail-back">
        View All Collections
      </a>
    </div>
  </section>
</div>

