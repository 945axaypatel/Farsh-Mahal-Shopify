{%- style -%}
  .fm-shipping-page {
    background-color: var(--fm-ivory);
    padding: clamp(50px, 8vw, 90px) 0;
  }
  .fm-shipping-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 56px auto;
  }
  .fm-shipping-header h1 {
    font-family: var(--fm-font-serif);
    font-size: clamp(3rem, 5vw, 4.6rem);
    color: var(--fm-forest);
    margin: 0 0 16px 0;
  }
  .fm-shipping-card {
    background: #FFFFFF;
    border: 1px solid var(--fm-border);
    padding: clamp(32px, 5vw, 48px);
    margin-bottom: 32px;
  }
  .fm-shipping-card h2 {
    font-family: var(--fm-font-serif);
    font-size: 2.4rem;
    color: var(--fm-forest);
    margin: 0 0 16px 0;
    border-bottom: 1px solid var(--fm-border-light);
    padding-bottom: 10px;
  }
{%- endstyle -%}

<div class="fm-shipping-page">
  <div class="fm-container-narrow">
    <div class="fm-shipping-header">
      <span class="fm-value-tagline">GLOBAL FULFILLMENT</span>
      <h1>Shipping Policy</h1>
      <p style="font-size: 1.6rem; color: #55524E; line-height: 1.7;">Delivery timelines, customs information, and global logistics procedures.</p>
    </div>

    <div class="fm-shipping-card">
      <h2>Shipping Charges & Free Delivery</h2>
      <ul class="fm-care-list">
        <li class="fm-care-list-item"><span class="fm-care-bold">Free Worldwide Shipping:</span> We offer complimentary shipping on all rug orders placed directly through our website.</li>
        <li class="fm-care-list-item"><span class="fm-care-bold">Customs & Import Duties:</span> For international orders outside India, local customs duties, VAT/GST, and import taxes are determined by your destination country's government regulations and payable at the time of delivery.</li>
      </ul>
    </div>

    <div class="fm-shipping-card">
      <h2>Order Processing & Delivery Timelines</h2>
      <ul class="fm-care-list">
        <li class="fm-care-list-item"><span class="fm-care-bold">Domestic Deliveries (India):</span> In-stock rugs are dispatched within 48 hours and typically delivered within <strong>3–10 business days</strong>.</li>
        <li class="fm-care-list-item"><span class="fm-care-bold">International Deliveries:</span> Delivered within <strong>6–12 business days</strong> via premium air couriers (DHL / FedEx Express).</li>
        <li class="fm-care-list-item"><span class="fm-care-bold">Custom & Made-to-Order Rugs:</span> Handcrafted production and delivery takes approximately <strong>5–7 weeks</strong> depending on size and intricate high-low carving detail.</li>
      </ul>
    </div>

    <div class="fm-shipping-card">
      <h2>Lost In Transit Procedures</h2>
      <p style="font-size: 1.55rem; line-height: 1.8; color: #55524E;">
        In the rare circumstance of a shipment lost in transit, contact us at <a href="mailto:farshmahal@gmail.com" style="color: var(--fm-forest); font-weight: 600;">farshmahal@gmail.com</a>. Upon courier confirmation, we will immediately initiate and dispatch a replacement rug at no cost to you. Disputes related to transit damage or misdelivery must be raised within <strong>48 hours of delivery attempt</strong>.
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FM Shipping Policy",
  "tag": "section",
  "class": "section-fm-shipping-policy",
  "settings": [],
  "presets": [
    {
      "name": "FM Shipping Policy"
    }
  ]
}
{% endschema %}
