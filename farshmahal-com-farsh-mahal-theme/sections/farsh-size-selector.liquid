<!-- Load exact Google Fonts for Size Selector -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,300;1,400;1,500;1,600&family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

{%- style -%}
  .fm-size-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile | default: 72 }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile | default: 72 }}px;
    background-color: {{ section.settings.bg_color | default: '#F7F2ED' }};
    border-top: 1px solid rgba(27, 67, 50, 0.10);
    border-bottom: 1px solid rgba(27, 67, 50, 0.10);
  }
  @media screen and (min-width: 768px) {
    .fm-size-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 112 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 112 }}px;
    }
  }

  .fm-size-container {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }
  @media screen and (min-width: 768px) {
    .fm-size-container {
      padding: 0 48px;
    }
  }

  /* Header */
  .fm-size-header {
    margin-bottom: 48px;
    max-width: 672px;
  }
  @media screen and (min-width: 768px) {
    .fm-size-header {
      margin-bottom: 56px;
    }
  }

  .fm-size-eyebrow {
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 11px !important;
    font-weight: 500 !important;
    letter-spacing: 0.32em !important;
    text-transform: uppercase !important;
    color: #C9A24D !important;
    margin: 0 0 12px 0;
    display: block;
    line-height: 1.4;
  }
  .fm-size-heading {
    font-family: 'Playfair Display', ui-serif, Georgia, Cambria, serif !important;
    font-size: 34px !important;
    line-height: 1.05 !important;
    letter-spacing: -0.02em !important;
    color: #1B4332 !important;
    text-transform: none !important;
    margin: 0 !important;
    font-weight: 400 !important;
  }
  @media screen and (min-width: 768px) {
    .fm-size-heading {
      font-size: 52px !important;
    }
  }
  .fm-size-head-italic {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-style: italic !important;
    font-weight: 400 !important;
    font-size: 1.05em !important;
    color: #1B4332 !important;
    letter-spacing: -0.01em !important;
    text-transform: none !important;
    display: inline-block !important;
  }

  .fm-size-subtext {
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 14px !important;
    line-height: 1.6 !important;
    color: rgba(27, 67, 50, 0.70) !important;
    max-width: 512px !important;
    margin-top: 18px !important;
    margin-bottom: 0 !important;
    font-weight: 400 !important;
  }
  @media screen and (min-width: 768px) {
    .fm-size-subtext {
      font-size: 15px !important;
      margin-top: 20px !important;
    }
  }
  .fm-size-subtext a {
    color: #1B4332 !important;
    text-decoration: underline !important;
    text-underline-offset: 3px;
    transition: color 0.3s ease;
  }
  .fm-size-subtext a:hover {
    color: #C9A24D !important;
  }

  /* 12 Size Tiles Grid: 2 cols on mobile, 4 on tablet, 6 on desktop */
  .fm-size-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  @media screen and (min-width: 640px) {
    .fm-size-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
  }
  @media screen and (min-width: 1024px) {
    .fm-size-grid {
      grid-template-columns: repeat(6, 1fr);
      gap: 20px;
    }
  }

  /* Size Tile Card */
  .fm-size-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background-color: #FAF7F2;
    border: 1px solid rgba(27, 67, 50, 0.12);
    padding: 28px 16px 22px 16px;
    min-height: 140px;
    text-decoration: none !important;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
  }
  .fm-size-tile:hover {
    background-color: #FFFFFF;
    border-color: #1B4332;
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(27, 67, 50, 0.08);
  }

  .fm-size-tile-label {
    font-family: 'Playfair Display', ui-serif, Georgia, Cambria, serif !important;
    font-size: 28px !important;
    line-height: 1.0 !important;
    color: #1B4332 !important;
    font-weight: 400 !important;
    margin: 0 !important;
  }
  @media screen and (min-width: 768px) {
    .fm-size-tile-label {
      font-size: 34px !important;
    }
  }

  .fm-size-tile-unit {
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 10px !important;
    letter-spacing: 0.24em !important;
    text-transform: uppercase !important;
    color: #738075 !important;
    margin-top: 8px !important;
    display: block;
    line-height: 1.2;
    font-weight: 500;
  }

  .fm-size-tile-desc {
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 12px !important;
    color: rgba(27, 67, 50, 0.70) !important;
    margin-top: 14px !important;
    line-height: 1.3 !important;
    font-weight: 400 !important;
  }
{%- endstyle -%}

<section class="fm-size-section-{{ section.id }}" data-testid="home-shop-by-size">
  <div class="fm-size-container">
    <!-- Header -->
    <div class="fm-size-header">
      <span class="fm-size-eyebrow">{{ section.settings.tagline | default: 'SHOP BY SIZE' }}</span>
      <h2 class="fm-size-heading">
        {{ section.settings.heading | default: 'Find your' }}
        <span class="fm-size-head-italic">{{ section.settings.heading_italic | default: 'perfect fit.' }}</span>
      </h2>
      <p class="fm-size-subtext">
        {{ section.settings.subtext_prefix | default: 'Not sure which size to pick? Our' }}
        <a href="{{ section.settings.guide_link | default: '/pages/rug-care-selection-guide' }}">{{ section.settings.guide_label | default: 'complete size guide' }}</a>
        {{ section.settings.subtext_suffix | default: 'walks you through every room in your home.' }}
      </p>
    </div>

    <!-- 12 Spatial Size Tiles Grid -->
    <div class="fm-size-grid">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: '/collections/all' }}"
          class="fm-size-tile"
          data-testid="home-size-{{ block.settings.size_title | handleize }}"
          {{ block.shopify_attributes }}
        >
          <div class="fm-size-tile-label">{{ block.settings.size_title | escape }}</div>
          {%- if block.settings.unit != blank and block.settings.unit != 'none' -%}
            <div class="fm-size-tile-unit">{{ block.settings.unit | escape }}</div>
          {%- endif -%}
          <div class="fm-size-tile-desc">{{ block.settings.size_desc | escape }}</div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FM Spatial Size Selector",
  "tag": "section",
  "class": "section-fm-size-selector",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Eyebrow Tagline",
      "default": "SHOP BY SIZE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Line 1",
      "default": "Find your"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading Line 2 (Italic Accent)",
      "default": "perfect fit."
    },
    {
      "type": "text",
      "id": "subtext_prefix",
      "label": "Subtext Prefix",
      "default": "Not sure which size to pick? Our"
    },
    {
      "type": "text",
      "id": "guide_label",
      "label": "Size Guide Link Label",
      "default": "complete size guide"
    },
    {
      "type": "url",
      "id": "guide_link",
      "label": "Size Guide URL"
    },
    {
      "type": "text",
      "id": "subtext_suffix",
      "label": "Subtext Suffix",
      "default": "walks you through every room in your home."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F7F2ED"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop Padding Top (px)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 110
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop Padding Bottom (px)",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 110
    }
  ],
  "blocks": [
    {
      "type": "size_tile",
      "name": "Size Tile",
      "settings": [
        {
          "type": "text",
          "id": "size_title",
          "label": "Size Title (e.g. 2 × 3, Runner)",
          "default": "2 × 3"
        },
        {
          "type": "text",
          "id": "unit",
          "label": "Unit Subtitle",
          "default": "ft"
        },
        {
          "type": "text",
          "id": "size_desc",
          "label": "Room / Space Description",
          "default": "Accent · Bath"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FM Spatial Size Selector",
      "blocks": [
        { "type": "size_tile", "settings": { "size_title": "2 × 3", "unit": "ft", "size_desc": "Accent · Bath", "link": "/collections/all" } },
        { "type": "size_tile", "settings": { "size_title": "3 × 5", "unit": "ft", "size_desc": "Entryway", "link": "/collections/all" } },
        { "type": "size_tile", "settings": { "size_title": "4 × 6", "unit": "ft", "size_desc": "Small nook", "link": "/collections/all" } },
        { "type": "size_tile", "settings": { "size_title": "5 × 8", "unit": "ft", "size_desc": "Reading area", "link": "/collections/all" } },
        { "type": "size_tile", "settings": { "size_title": "6 × 9", "unit": "ft", "size_desc": "Cozy living", "link": "/collections/all" } },
        { "type": "size_tile", "settings": { "size_title": "8 × 10", "unit": "ft", "size_desc": "Living room", "link": "/collections/all" } },
        { "type": "size_tile", "settings": { "size_title": "9 × 12", "unit": "ft", "size_desc": "Grand living", "link": "/collections/all" } },
        { "type": "size_tile", "settings": { "size_title": "10 × 14", "unit": "ft", "size_desc": "Great room", "link": "/collections/all" } },
        { "type": "size_tile", "settings": { "size_title": "12 × 15", "unit": "ft", "size_desc": "Estate", "link": "/collections/all" } },
        { "type": "size_tile", "settings": { "size_title": "Runner", "unit": "ft", "size_desc": "Halls · kitchens", "link": "/collections/all" } },
        { "type": "size_tile", "settings": { "size_title": "Round", "unit": "ft", "size_desc": "Foyers · dining", "link": "/collections/all" } },
        { "type": "size_tile", "settings": { "size_title": "Custom", "unit": "ft", "size_desc": "Made to order", "link": "/pages/custom-rugs" } }
      ]
    }
  ]
}
{% endschema %}
