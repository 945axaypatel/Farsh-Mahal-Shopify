{%- style -%}
  /* Farsh Mahal Master Homepage Styles */
  .fm-home-wrapper {
    background-color: var(--fm-ivory);
    color: var(--fm-charcoal);
  }

  /* 1. Hero Section */
  .fm-master-hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    background-image: url('{{ "fm-hero-lifestyle.jpg" | asset_url }}');
    background-size: cover;
    background-position: center;
    padding: 80px 24px;
  }
  .fm-master-hero-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(90deg, rgba(20, 24, 22, 0.75) 0%, rgba(20, 24, 22, 0.45) 50%, rgba(0,0,0,0.15) 100%);
    z-index: 1;
  }
  .fm-master-hero-content {
    position: relative;
    z-index: 2;
    max-width: 650px;
  }
  .fm-master-hero-title {
    font-family: var(--fm-font-serif);
    font-size: clamp(3.6rem, 6vw, 6rem);
    color: #FFFFFF !important;
    line-height: 1.08;
    margin: 0 0 20px 0;
    font-weight: 400;
  }
  .fm-master-hero-sub {
    font-size: clamp(1.5rem, 1.8vw, 1.75rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 36px;
    font-weight: 300;
  }
  .fm-hero-btn-white {
    background-color: #FFFFFF !important;
    color: var(--fm-forest) !important;
    border: 1px solid #FFFFFF !important;
  }
  .fm-hero-btn-white:hover {
    background-color: var(--fm-gold) !important;
    color: #FFFFFF !important;
    border-color: var(--fm-gold) !important;
  }
  .fm-hero-btn-ghost {
    background-color: transparent !important;
    color: #FFFFFF !important;
    border: 1px solid rgba(255, 255, 255, 0.7) !important;
  }
  .fm-hero-btn-ghost:hover {
    background-color: #FFFFFF !important;
    color: var(--fm-forest) !important;
  }

  /* 2. Value Statement */
  .fm-value-split {
    padding: clamp(60px, 8vw, 100px) 0;
    background-color: var(--fm-ivory);
    border-bottom: 1px solid var(--fm-border-light);
  }
  .fm-value-split-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 48px;
    align-items: center;
  }
  .fm-value-accent-quote {
    font-family: var(--fm-font-serif);
    font-size: 2.2rem;
    color: var(--fm-gold);
    font-style: italic;
    border-left: 2px solid var(--fm-gold);
    padding-left: 20px;
    line-height: 1.4;
  }
  .fm-value-split-title {
    font-family: var(--fm-font-serif);
    font-size: clamp(2.6rem, 4vw, 4rem);
    color: var(--fm-forest);
    line-height: 1.2;
    margin: 0 0 20px 0;
    font-weight: 400;
  }
  .fm-value-split-title em {
    color: var(--fm-gold);
    font-style: italic;
  }

  /* 3. Collections Grid */
  .fm-curated-section {
    padding: clamp(60px, 8vw, 100px) 0;
    background-color: var(--fm-ivory);
  }
  .fm-curated-grid-top {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 24px;
    margin-bottom: 24px;
  }
  .fm-curated-grid-bottom {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .fm-curated-card {
    position: relative;
    height: 380px;
    background-color: #E6E0D6;
    background-size: cover;
    background-position: center;
    border: 1px solid var(--fm-border);
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 32px;
    transition: var(--fm-transition);
  }
  .fm-curated-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(27, 67, 50, 0.12);
    border-color: var(--fm-gold);
  }
  .fm-curated-card-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(20, 24, 22, 0.85) 100%);
    z-index: 1;
    transition: var(--fm-transition);
  }
  .fm-curated-card:hover .fm-curated-card-overlay {
    background: linear-gradient(180deg, rgba(0,0,0,0.1) 20%, rgba(20, 24, 22, 0.92) 100%);
  }
  .fm-curated-card-content {
    position: relative;
    z-index: 2;
  }
  .fm-curated-card-title {
    font-family: var(--fm-font-serif);
    font-size: 2.6rem;
    color: #FFFFFF !important;
    margin: 0 0 6px 0;
    font-weight: 500;
  }
  .fm-curated-card-sub {
    font-size: 1.4rem;
    color: rgba(247, 242, 237, 0.85) !important;
    margin: 0;
  }

  /* 4. Trust Bar */
  .fm-trust-bar {
    padding: 36px 0;
    background-color: #FFFFFF;
    border-top: 1px solid var(--fm-border);
    border-bottom: 1px solid var(--fm-border);
  }
  .fm-trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }
  .fm-trust-item {
    font-size: 1.35rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fm-forest);
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .fm-trust-dot {
    color: var(--fm-gold);
    font-size: 1.6rem;
  }

  /* 5. Product Grid */
  .fm-arrivals-section {
    padding: clamp(60px, 8vw, 100px) 0;
    background-color: var(--fm-ivory);
  }
  .fm-arrivals-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .fm-product-grid-8 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .fm-rug-card {
    background-color: #FFFFFF;
    border: 1px solid var(--fm-border);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--fm-transition);
  }
  .fm-rug-card:hover {
    transform: translateY(-4px);
    border-color: var(--fm-gold);
    box-shadow: 0 12px 30px rgba(27, 67, 50, 0.08);
  }
  .fm-rug-badge-new {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: var(--fm-gold);
    color: #FFFFFF;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 4px 8px;
    z-index: 2;
  }
  .fm-rug-img-wrap {
    padding: 24px;
    background-color: var(--fm-ivory-light);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 280px;
  }
  .fm-rug-img-wrap img, .fm-rug-img-wrap svg {
    max-height: 240px;
    width: auto;
    object-fit: contain;
    transition: transform 0.4s ease;
  }
  .fm-rug-card:hover .fm-rug-img-wrap img,
  .fm-rug-card:hover .fm-rug-img-wrap svg {
    transform: scale(1.04);
  }
  .fm-rug-card-info {
    padding: 20px 24px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-top: 1px solid var(--fm-border-light);
  }
  .fm-rug-name {
    font-family: var(--fm-font-serif);
    font-size: 2rem;
    color: var(--fm-forest);
    margin: 0 0 4px 0;
  }
  .fm-rug-series {
    font-size: 1.3rem;
    color: #777;
    margin: 0;
  }
  .fm-rug-price {
    font-family: var(--fm-font-sans);
    font-size: 1.55rem;
    font-weight: 600;
    color: var(--fm-forest);
  }

  /* 6. Size Selector Grid */
  .fm-sizes-section {
    padding: clamp(60px, 8vw, 90px) 0;
    background-color: var(--fm-ivory-light);
    border-top: 1px solid var(--fm-border);
    border-bottom: 1px solid var(--fm-border);
    text-align: center;
  }
  .fm-sizes-tiles-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
    margin-top: 36px;
  }
  .fm-size-tile {
    background: #FFFFFF;
    border: 1px solid var(--fm-border);
    padding: 18px 12px;
    text-decoration: none;
    transition: var(--fm-transition);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .fm-size-tile:hover {
    background: var(--fm-forest);
    border-color: var(--fm-forest);
    transform: translateY(-3px);
  }
  .fm-size-tile-name {
    font-family: var(--fm-font-serif);
    font-size: 1.9rem;
    color: var(--fm-forest);
    font-weight: 500;
    margin-bottom: 4px;
    transition: var(--fm-transition);
  }
  .fm-size-tile-desc {
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    color: #888;
    transition: var(--fm-transition);
  }
  .fm-size-tile:hover .fm-size-tile-name {
    color: var(--fm-gold) !important;
  }
  .fm-size-tile:hover .fm-size-tile-desc {
    color: var(--fm-ivory) !important;
  }

  /* 7. Craftsmanship Section */
  .fm-master-craft {
    background-color: var(--fm-forest);
    color: var(--fm-ivory);
    padding: clamp(70px, 9vw, 110px) 0;
  }
  .fm-master-craft-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .fm-craft-stats-2x2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 36px;
    border-top: 1px solid rgba(201, 162, 77, 0.3);
    padding-top: 28px;
    margin: 36px 0;
  }

  /* 8. Dual Feature Large Cards */
  .fm-dual-large-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    padding: clamp(60px, 8vw, 90px) 0;
  }
  .fm-dual-large-card {
    height: 480px;
    position: relative;
    background-size: cover;
    background-position: center;
    border: 1px solid var(--fm-border);
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(32px, 5vw, 48px);
    transition: var(--fm-transition);
  }
  .fm-dual-large-card:hover {
    border-color: var(--fm-gold);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
  }

  /* 9. Journal Section */
  .fm-journal-section {
    padding: clamp(60px, 8vw, 100px) 0;
    background-color: var(--fm-ivory);
  }
  .fm-journal-3-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 24px;
  }
  .fm-journal-story-card {
    background: #FFFFFF;
    border: 1px solid var(--fm-border);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: var(--fm-transition);
  }
  .fm-journal-story-card:hover {
    border-color: var(--fm-gold);
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(27, 67, 50, 0.08);
  }
  .fm-journal-story-img {
    height: 260px;
    background-size: cover;
    background-position: center;
  }
  .fm-journal-story-info {
    padding: 24px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Responsive Queries */
  @media screen and (max-width: 1024px) {
    .fm-product-grid-8 {
      grid-template-columns: repeat(2, 1fr);
    }
    .fm-sizes-tiles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .fm-trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .fm-journal-3-grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 768px) {
    .fm-value-split-grid,
    .fm-curated-grid-top,
    .fm-curated-grid-bottom,
    .fm-master-craft-grid,
    .fm-dual-large-grid {
      grid-template-columns: 1fr;
    }
    .fm-sizes-tiles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .fm-trust-grid {
      grid-template-columns: 1fr;
    }
    .fm-curated-card {
      height: 300px;
    }
    .fm-dual-large-card {
      height: 380px;
    }
  }
{%- endstyle -%}

