{%- style -%}
  .fm-legal-page {
    background-color: var(--fm-ivory);
    padding: clamp(50px, 8vw, 90px) 0;
  }
  .fm-legal-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 56px auto;
  }
  .fm-legal-header h1 {
    font-family: var(--fm-font-serif);
    font-size: clamp(3rem, 5vw, 4.6rem);
    color: var(--fm-forest);
    margin: 0 0 16px 0;
  }
  .fm-legal-card {
    background: #FFFFFF;
    border: 1px solid var(--fm-border);
    padding: clamp(32px, 5vw, 48px);
    margin-bottom: 32px;
  }
  .fm-legal-card h2 {
    font-family: var(--fm-font-serif);
    font-size: 2.4rem;
    color: var(--fm-forest);
    margin: 0 0 16px 0;
    border-bottom: 1px solid var(--fm-border-light);
    padding-bottom: 10px;
  }
  .fm-legal-card h3 {
    font-family: var(--fm-font-serif);
    font-size: 2rem;
    color: var(--fm-forest);
    margin: 20px 0 10px 0;
  }
  .fm-legal-text {
    font-size: 1.55rem;
    line-height: 1.8;
    color: #4F4D4A;
    margin-bottom: 16px;
  }
{%- endstyle -%}

<div class="fm-legal-page">
  <div class="fm-container-narrow">
    <div class="fm-legal-header">
      <span class="fm-value-tagline">DATA PROTECTION</span>
      <h1>Privacy Policy</h1>
      <p style="font-size: 1.6rem; color: #55524E; line-height: 1.7;">Safeguarding your personal information at Farsh Mahal.</p>
    </div>

    <div class="fm-legal-card">
      <h2>Introduction & Scope</h2>
      <p class="fm-legal-text">
        This Privacy Policy describes how your personal information is collected, used, and shared when you visit or make a purchase from <strong>https://farshmahal.com</strong>.
      </p>
      <p class="fm-legal-text">
        <strong>Entity Details:</strong> Farsh Mahal by M & G Enterprise, 34, Krushnam Gokulam Society, B/H Avsar Party Plot Road, Mehsana, Gujarat, India 384002. Email: <a href="mailto:farshmahal@gmail.com" style="color: var(--fm-forest); font-weight: 600;">farshmahal@gmail.com</a>.
      </p>
    </div>

    <div class="fm-legal-card">
      <h2>Personal Information We Collect</h2>
      <p class="fm-legal-text">
        When you visit our site, we automatically collect certain information about your device, browser, IP address, and cookie identifiers. Additionally, when you place an order, make a custom rug inquiry, or sign up for updates, we collect your <strong>Full Name, Email Address, Contact Phone Number, Billing/Shipping Address</strong>, and encrypted payment tokens.
      </p>
      <p class="fm-legal-text">
        We do not store complete credit card or net banking credentials on our servers. All transactions are securely processed through industry-standard certified payment gateways with 256-bit SSL encryption.
      </p>
    </div>

    <div class="fm-legal-card">
      <h2>How We Use Your Information</h2>
      <ul class="fm-care-list">
        <li class="fm-care-list-item"><span class="fm-care-bold">Order Fulfillment:</span> To process payments, arrange global freight, generate commercial invoices, and provide tracking links.</li>
        <li class="fm-care-list-item"><span class="fm-care-bold">Customer Concierge:</span> To communicate regarding custom design specifications, size advice, or trade inquiries.</li>
        <li class="fm-care-list-item"><span class="fm-care-bold">Security & Fraud Prevention:</span> To screen orders for potential risk and maintain encrypted transaction logs.</li>
      </ul>
    </div>

    <div class="fm-legal-card">
      <h2>Global Regulatory Compliance & Your Rights</h2>
      <ul class="fm-care-list">
        <li class="fm-care-list-item"><span class="fm-care-bold">EEA & UK (GDPR):</span> You have the right to access, rectify, erase, or restrict processing of your personal data at any time.</li>
        <li class="fm-care-list-item"><span class="fm-care-bold">California (CCPA / CPRA):</span> You have the right to request deletion or opt-out of data sharing. We never sell your personal information.</li>
        <li class="fm-care-list-item"><span class="fm-care-bold">India (DPDP Act, 2023):</span> You may access, correct, or request erasure of your data via our Grievance Officer at <a href="mailto:farshmahal@gmail.com">farshmahal@gmail.com</a>.</li>
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FM Privacy Policy",
  "tag": "section",
  "class": "section-fm-privacy-policy",
  "settings": [],
  "presets": [
    {
      "name": "FM Privacy Policy"
    }
  ]
}
{% endschema %}
