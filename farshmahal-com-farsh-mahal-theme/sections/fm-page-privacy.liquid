{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

<style>
  .fm-priv-page-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FBF8F4' }};
    color: {{ section.settings.text_color | default: '#1B4332' }};
    min-height: 100vh;
  }
  .fm-priv-header-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_header | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom_header | default: 40 }}px;
    border-bottom: 1px solid {{ section.settings.border_color | default: 'rgba(27, 67, 50, 0.12)' }};
  }
  .fm-priv-header-inner-{{ section.id }} {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: {{ section.settings.header_alignment | default: 'left' }};
  }
  .fm-priv-eyebrow-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#1B4332' }};
    font-weight: 500;
  }
  .fm-priv-title-{{ section.id }} {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 5.5vw, {{ section.settings.title_font_size | default: 64 }}px);
    line-height: 1.05;
    color: {{ section.settings.text_color | default: '#1B4332' }};
    letter-spacing: -0.02em;
    margin-top: 16px;
    margin-bottom: 0;
    max-width: 850px;
    font-weight: 400;
  }
  .fm-priv-subtitle-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.subtitle_font_size | default: 15 }}px;
    line-height: 1.65;
    color: {{ section.settings.subtitle_color | default: 'rgba(27, 67, 50, 0.75)' }};
    margin-top: 24px;
    margin-bottom: 0;
    max-width: 680px;
  }
  .fm-priv-body-{{ section.id }} {
    max-width: {{ section.settings.body_container_width | default: 900 }}px;
    margin: 0 auto;
    padding-top: {{ section.settings.padding_top_body | default: 64 }}px;
    padding-bottom: {{ section.settings.padding_bottom_body | default: 100 }}px;
    padding-left: 24px;
    padding-right: 24px;
  }
  .fm-priv-h2-{{ section.id }},
  .fm-priv-cat-title-{{ section.id }} {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(24px, 3vw, 34px);
    color: {{ section.settings.text_color | default: '#1B4332' }};
    line-height: 1.15;
    margin-top: 56px;
    margin-bottom: 20px;
    font-weight: 400;
  }
  .fm-priv-h2-{{ section.id }}:first-of-type,
  .fm-priv-cat-title-{{ section.id }}:first-of-type {
    margin-top: 0;
  }
  .fm-priv-h3-{{ section.id }},
  .fm-priv-subcat-title-{{ section.id }} {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(18px, 2.2vw, 22px);
    color: {{ section.settings.text_color | default: '#1B4332' }};
    line-height: 1.25;
    margin-top: 40px;
    margin-bottom: 14px;
    font-weight: 400;
  }
  .fm-priv-p-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.body_font_size | default: 15 }}px;
    color: {{ section.settings.text_color | default: 'rgba(27, 67, 50, 0.85)' }};
    line-height: 1.75;
    margin-bottom: 16px;
  }
  .fm-priv-ul-{{ section.id }} {
    list-style: disc;
    padding-left: 24px;
    margin-bottom: 24px;
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.body_font_size | default: 15 }}px;
    line-height: 1.8;
    color: {{ section.settings.text_color | default: 'rgba(27, 67, 50, 0.85)' }};
  }
  .fm-priv-ul-{{ section.id }} li {
    margin-bottom: 8px;
  }
  .fm-priv-ul-{{ section.id }} li::marker {
    color: {{ section.settings.accent_color | default: '#C1914E' }};
  }
  .fm-priv-qa-{{ section.id }},
  .fm-priv-item-{{ section.id }} {
    border-top: 1px solid {{ section.settings.border_color | default: 'rgba(27, 67, 50, 0.1)' }};
    padding-top: 24px;
    margin-top: 24px;
  }
  .fm-priv-h2-{{ section.id }} + .fm-priv-qa-{{ section.id }},
  .fm-priv-cat-title-{{ section.id }} + .fm-priv-item-{{ section.id }},
  .fm-priv-h3-{{ section.id }} + .fm-priv-qa-{{ section.id }},
  .fm-priv-subcat-title-{{ section.id }} + .fm-priv-item-{{ section.id }} {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }
  .fm-priv-q-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: {{ section.settings.text_color | default: '#1B4332' }};
    margin-bottom: 12px;
    line-height: 1.4;
  }
  .fm-priv-a-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.body_font_size | default: 15 }}px;
    color: {{ section.settings.subtitle_color | default: 'rgba(27, 67, 50, 0.75)' }};
    line-height: 1.75;
  }
  .fm-priv-link-{{ section.id }} {
    color: {{ section.settings.text_color | default: '#1B4332' }};
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .fm-priv-link-{{ section.id }}:hover {
    color: {{ section.settings.accent_color | default: '#C1914E' }};
  }
  .fm-priv-card-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin: 32px 0 48px 0;
  }
  .fm-priv-card-{{ section.id }} {
    background: #FFFFFF;
    border: 1px solid {{ section.settings.border_color | default: 'rgba(27, 67, 50, 0.1)' }};
    padding: 24px;
    border-radius: 2px;
  }
  .fm-priv-card-title-{{ section.id }} {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 18px;
    color: {{ section.settings.text_color | default: '#1B4332' }};
    margin-bottom: 8px;
  }
  .fm-priv-card-desc-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: {{ section.settings.subtitle_color | default: 'rgba(27, 67, 50, 0.75)' }};
  }
</style>

<div class="fm-priv-page-{{ section.id }}" data-testid="content-page-fm-priv">
  <header class="fm-priv-header-{{ section.id }}">
    <div class="fm-priv-header-inner-{{ section.id }}">
      <div class="fm-priv-eyebrow-{{ section.id }}">{{ section.settings.eyebrow | default: 'Policy' }}</div>
      <h1 class="fm-priv-title-{{ section.id }}">{{ section.settings.title | default: 'Privacy Policy' }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="fm-priv-subtitle-{{ section.id }}">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
  </header>

  <div class="fm-priv-body-{{ section.id }}">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading_block' -%}
            <h2 class="fm-priv-h2-{{ section.id }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'qa_block' -%}
            <div class="fm-priv-qa-{{ section.id }}" {{ block.shopify_attributes }}>
              <div class="fm-priv-q-{{ section.id }}">{{ block.settings.question }}</div>
              <div class="fm-priv-a-{{ section.id }}">{{ block.settings.answer }}</div>
            </div>
          {%- when 'richtext_block' -%}
            <div class="fm-priv-p-{{ section.id }}" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>
          {%- when 'card_block' -%}
            <div class="fm-priv-card-{{ section.id }}" {{ block.shopify_attributes }}>
              <div class="fm-priv-card-title-{{ section.id }}">{{ block.settings.title }}</div>
              <div class="fm-priv-card-desc-{{ section.id }}">{{ block.settings.description }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    {%- else -%}
<h2 class="fm-priv-h2">Personal information we collect</h2>
    <p class="fm-priv-p">When you visit or purchase from Farsh Mahal, we collect information necessary to fulfill your orders, provide customer care, and enhance your digital browsing experience:</p>
    <ul class="fm-priv-ul">
      <li><strong>Contact & Identity Data:</strong> Name, delivery address, billing address, email address, and phone number.</li>
      <li><strong>Order & Transaction Data:</strong> Items purchased, order value, payment status, and shipping logs.</li>
      <li><strong>Device & Analytics Data:</strong> IP address, browser type, device identifiers, and pages viewed.</li>
    </ul>

    <h2 class="fm-priv-h2">How we use your information</h2>
    <p class="fm-priv-p">We use your data strictly for legitimate operational purposes:</p>
    <ul class="fm-priv-ul">
      <li>Processing transactions, dispatching orders, and transmitting tracking alerts.</li>
      <li>Providing responsive customer support and managing returns or exchanges.</li>
      <li>Detecting fraud and maintaining platform security.</li>
      <li>Sending curated newsletters and design updates (only with your explicit opt-in).</li>
    </ul>

    <h2 class="fm-priv-h2">Controlling your personal information</h2>
    <p class="fm-priv-p">We respect your privacy rights across all jurisdictions:</p>
    <ul class="fm-priv-ul">
      <li><strong>EEA / UK / Switzerland (GDPR):</strong> Right to access, rectify, erase, restrict, or port your personal data.</li>
      <li><strong>California (CCPA/CPRA):</strong> Right to know, delete, correct, and opt out of data sharing. We never sell your personal data.</li>
      <li><strong>India (DPDP Act, 2023):</strong> Right to access, correction, erasure, and grievance redressal.</li>
    </ul>

    <h2 class="fm-priv-h2">Security & payment information</h2>
    <p class="fm-priv-p">All online transactions are encrypted via industry-standard SSL/TLS protocols and processed through PCI-DSS certified payment gateways. We never store complete credit or debit card numbers on our servers.</p>

    <h2 class="fm-priv-h2">Third-party services and links</h2>
    <p class="fm-priv-p">We only share information with trusted third-party service providers (such as courier partners, payment processors, and hosting infrastructure) strictly to the extent necessary to perform their respective services.</p>

    <h2 class="fm-priv-h2">Changes to this Privacy Policy</h2>
    <p class="fm-priv-p">We may update this policy periodically to reflect changes in our operational or legal practices. Updates take effect immediately upon publication on this page.</p>

    <h2 class="fm-priv-h2">Contact</h2>
    <p class="fm-priv-p">For privacy inquiries or data requests, please contact our Privacy Officer at <a href="mailto:farshmahal@gmail.com" class="fm-priv-link">farshmahal@gmail.com</a>.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FM Privacy Policy",
  "tag": "section",
  "class": "section-fm-priv",
  "settings": [
    {
      "type": "header",
      "content": "Page Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Policy"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Privacy Policy"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "How we collect, use, and safeguard your data."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FBF8F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1B4332"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle / Answer Color",
      "default": "rgba(27, 67, 50, 0.75)"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#C1914E"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border / Divider Color",
      "default": "rgba(27, 67, 50, 0.12)"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_header",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Header Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_header",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Header Padding Bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_body",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Body Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_body",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Body Padding Bottom",
      "default": 100
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Header Container Width",
      "default": 1100
    },
    {
      "type": "range",
      "id": "body_container_width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Body Container Width",
      "default": 900
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Title Font Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "subtitle_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Font Size",
      "default": 15
    },
    {
      "type": "range",
      "id": "body_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Body Font Size",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "heading_block",
      "name": "Heading / Category",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading Text",
          "default": "Section Heading"
        }
      ]
    },
    {
      "type": "qa_block",
      "name": "Q&A / Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question text here"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Answer text goes here."
        }
      ]
    },
    {
      "type": "richtext_block",
      "name": "Rich Text / Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Content goes here.</p>"
        }
      ]
    },
    {
      "type": "card_block",
      "name": "Feature / Benefit Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description",
          "default": "Description of the feature."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FM Privacy Policy"
    }
  ]
}
{% endschema %}
