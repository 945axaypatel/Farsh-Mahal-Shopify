<!-- Farsh Mahal - Our Philosophy / Value Statement Section -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">

{%- style -%}
  .fm-val-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FAF7F2' }};
    padding-top: {{ section.settings.padding_top | default: 128 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 152 }}px;
  }
  .fm-val-container-{{ section.id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }
  @media screen and (min-width: 768px) {
    .fm-val-container-{{ section.id }} {
      padding: 0 48px;
    }
  }

  .fm-val-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media screen and (min-width: 900px) {
    .fm-val-grid {
      grid-template-columns: 3.6fr 8.4fr;
      gap: 64px;
    }
  }

  /* Left Column */
  .fm-val-left {
    padding-top: 12px;
  }
  .fm-val-eyebrow {
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 0.32em !important;
    text-transform: uppercase !important;
    color: #C1914E !important;
    margin: 0 0 16px 0 !important;
    display: block !important;
    line-height: 1.4 !important;
  }
  .fm-val-divider {
    width: 42px;
    height: 1.5px;
    background-color: #C1914E;
    margin: 0 0 18px 0;
  }
  .fm-val-origin {
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 11px !important;
    font-weight: 500 !important;
    letter-spacing: 0.22em !important;
    text-transform: uppercase !important;
    color: #55685D !important;
    margin: 0 !important;
    display: block !important;
    line-height: 1.4 !important;
  }

  /* Right Column */
  .fm-val-right {
    display: flex;
    flex-direction: column;
  }
  .fm-val-heading {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: clamp(38px, 5.8vw, 76px) !important;
    font-weight: 400 !important;
    color: #1B4332 !important;
    line-height: 1.08 !important;
    letter-spacing: -0.015em !important;
    margin: 0 !important;
    text-transform: none !important;
  }
  .fm-val-heading-italic {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-style: italic !important;
    font-weight: 400 !important;
    font-size: 1em !important;
    color: #C1914E !important;
    display: block !important;
    letter-spacing: -0.015em !important;
    margin-top: 4px !important;
    text-transform: none !important;
  }

  .fm-val-lead-paragraph {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: clamp(18px, 2.2vw, 25px) !important;
    line-height: 1.55 !important;
    color: rgba(27, 67, 50, 0.90) !important;
    margin: 36px 0 0 0 !important;
    max-width: 820px !important;
    font-weight: 400 !important;
  }
  .fm-val-body-paragraph {
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 15px !important;
    line-height: 1.75 !important;
    color: rgba(27, 67, 50, 0.68) !important;
    margin: 24px 0 0 0 !important;
    max-width: 820px !important;
    font-weight: 400 !important;
  }
{%- endstyle -%}

<section class="fm-val-section-{{ section.id }}" aria-label="Our Philosophy">
  <div class="fm-val-container-{{ section.id }}">
    <div class="fm-val-grid">
      <!-- Left Column: Eyebrow + Divider + Origin Text -->
      <div class="fm-val-left">
        <span class="fm-val-eyebrow">{{ section.settings.eyebrow | default: 'OUR PHILOSOPHY' }}</span>
        <div class="fm-val-divider"></div>
        <span class="fm-val-origin">{{ section.settings.origin_text | default: 'EST. BHADOHI & RAJASTHAN · INDIA' }}</span>
      </div>

      <!-- Right Column: Heading + Lead Paragraph + Body Paragraph -->
      <div class="fm-val-right">
        <h2 class="fm-val-heading">
          {{ section.settings.heading_line1 | default: 'More than a rug —' }}
          <span class="fm-val-heading-italic">{{ section.settings.heading_line2 | default: 'the foundation of home.' }}</span>
        </h2>
        {%- if section.settings.lead_paragraph != blank -%}
          <p class="fm-val-lead-paragraph">{{ section.settings.lead_paragraph }}</p>
        {%- endif -%}
        {%- if section.settings.body_paragraph != blank -%}
          <p class="fm-val-body-paragraph">{{ section.settings.body_paragraph }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FM Philosophy Statement",
  "tag": "section",
  "class": "section-fm-value-statement",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "origin_text",
      "label": "Origin Text",
      "default": "EST. BHADOHI & RAJASTHAN · INDIA"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading Line 1",
      "default": "More than a rug —"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading Line 2 (Gold Italic)",
      "default": "the foundation of home."
    },
    {
      "type": "textarea",
      "id": "lead_paragraph",
      "label": "Lead Paragraph",
      "default": "Every room begins from the ground up. The right rug doesn't simply complete a space — it defines it. It creates warmth, adds character, and becomes the foundation for everyday living."
    },
    {
      "type": "textarea",
      "id": "body_paragraph",
      "label": "Body Paragraph",
      "default": "At Farsh Mahal, we combine generations of Indian craftsmanship from Bhadohi and Rajasthan with contemporary interior design to create hand-tufted rugs that feel timeless, comfortable, and beautifully at home."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Padding Top",
      "default": 128
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 152
    }
  ],
  "presets": [
    {
      "name": "FM Philosophy Statement"
    }
  ]
}
{% endschema %}
