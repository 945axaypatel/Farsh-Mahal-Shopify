{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

<style>
  .fm-care-page-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FBF8F4' }};
    color: {{ section.settings.text_color | default: '#1B4332' }};
    min-height: 100vh;
  }
  .fm-care-header-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_header | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom_header | default: 40 }}px;
    border-bottom: 1px solid {{ section.settings.border_color | default: 'rgba(27, 67, 50, 0.12)' }};
  }
  .fm-care-header-inner-{{ section.id }} {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: {{ section.settings.header_alignment | default: 'left' }};
  }
  .fm-care-eyebrow-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#1B4332' }};
    font-weight: 500;
  }
  .fm-care-title-{{ section.id }} {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 5.5vw, {{ section.settings.title_font_size | default: 64 }}px);
    line-height: 1.05;
    color: {{ section.settings.text_color | default: '#1B4332' }};
    letter-spacing: -0.02em;
    margin-top: 16px;
    margin-bottom: 0;
    max-width: 850px;
    font-weight: 400;
  }
  .fm-care-subtitle-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.subtitle_font_size | default: 15 }}px;
    line-height: 1.65;
    color: {{ section.settings.subtitle_color | default: 'rgba(27, 67, 50, 0.75)' }};
    margin-top: 24px;
    margin-bottom: 0;
    max-width: 680px;
  }
  .fm-care-body-{{ section.id }} {
    max-width: {{ section.settings.body_container_width | default: 900 }}px;
    margin: 0 auto;
    padding-top: {{ section.settings.padding_top_body | default: 64 }}px;
    padding-bottom: {{ section.settings.padding_bottom_body | default: 100 }}px;
    padding-left: 24px;
    padding-right: 24px;
  }
  .fm-care-h2-{{ section.id }},
  .fm-care-cat-title-{{ section.id }} {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(24px, 3vw, 34px);
    color: {{ section.settings.text_color | default: '#1B4332' }};
    line-height: 1.15;
    margin-top: 56px;
    margin-bottom: 20px;
    font-weight: 400;
  }
  .fm-care-h2-{{ section.id }}:first-of-type,
  .fm-care-cat-title-{{ section.id }}:first-of-type {
    margin-top: 0;
  }
  .fm-care-h3-{{ section.id }},
  .fm-care-subcat-title-{{ section.id }} {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(18px, 2.2vw, 22px);
    color: {{ section.settings.text_color | default: '#1B4332' }};
    line-height: 1.25;
    margin-top: 40px;
    margin-bottom: 14px;
    font-weight: 400;
  }
  .fm-care-p-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.body_font_size | default: 15 }}px;
    color: {{ section.settings.text_color | default: 'rgba(27, 67, 50, 0.85)' }};
    line-height: 1.75;
    margin-bottom: 16px;
  }
  .fm-care-ul-{{ section.id }} {
    list-style: disc;
    padding-left: 24px;
    margin-bottom: 24px;
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.body_font_size | default: 15 }}px;
    line-height: 1.8;
    color: {{ section.settings.text_color | default: 'rgba(27, 67, 50, 0.85)' }};
  }
  .fm-care-ul-{{ section.id }} li {
    margin-bottom: 8px;
  }
  .fm-care-ul-{{ section.id }} li::marker {
    color: {{ section.settings.accent_color | default: '#C1914E' }};
  }
  .fm-care-qa-{{ section.id }},
  .fm-care-item-{{ section.id }} {
    border-top: 1px solid {{ section.settings.border_color | default: 'rgba(27, 67, 50, 0.1)' }};
    padding-top: 24px;
    margin-top: 24px;
  }
  .fm-care-h2-{{ section.id }} + .fm-care-qa-{{ section.id }},
  .fm-care-cat-title-{{ section.id }} + .fm-care-item-{{ section.id }},
  .fm-care-h3-{{ section.id }} + .fm-care-qa-{{ section.id }},
  .fm-care-subcat-title-{{ section.id }} + .fm-care-item-{{ section.id }} {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }
  .fm-care-q-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: {{ section.settings.text_color | default: '#1B4332' }};
    margin-bottom: 12px;
    line-height: 1.4;
  }
  .fm-care-a-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.body_font_size | default: 15 }}px;
    color: {{ section.settings.subtitle_color | default: 'rgba(27, 67, 50, 0.75)' }};
    line-height: 1.75;
  }
  .fm-care-link-{{ section.id }} {
    color: {{ section.settings.text_color | default: '#1B4332' }};
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .fm-care-link-{{ section.id }}:hover {
    color: {{ section.settings.accent_color | default: '#C1914E' }};
  }
  .fm-care-card-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin: 32px 0 48px 0;
  }
  .fm-care-card-{{ section.id }} {
    background: #FFFFFF;
    border: 1px solid {{ section.settings.border_color | default: 'rgba(27, 67, 50, 0.1)' }};
    padding: 24px;
    border-radius: 2px;
  }
  .fm-care-card-title-{{ section.id }} {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 18px;
    color: {{ section.settings.text_color | default: '#1B4332' }};
    margin-bottom: 8px;
  }
  .fm-care-card-desc-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: {{ section.settings.subtitle_color | default: 'rgba(27, 67, 50, 0.75)' }};
  }
</style>

<div class="fm-care-page-{{ section.id }}" data-testid="content-page-fm-care">
  <header class="fm-care-header-{{ section.id }}">
    <div class="fm-care-header-inner-{{ section.id }}">
      <div class="fm-care-eyebrow-{{ section.id }}">{{ section.settings.eyebrow | default: 'Guide' }}</div>
      <h1 class="fm-care-title-{{ section.id }}">{{ section.settings.title | default: 'Rug Care & Selection Guide' }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="fm-care-subtitle-{{ section.id }}">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
  </header>

  <div class="fm-care-body-{{ section.id }}">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading_block' -%}
            <h2 class="fm-care-h2-{{ section.id }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'qa_block' -%}
            <div class="fm-care-qa-{{ section.id }}" {{ block.shopify_attributes }}>
              <div class="fm-care-q-{{ section.id }}">{{ block.settings.question }}</div>
              <div class="fm-care-a-{{ section.id }}">{{ block.settings.answer }}</div>
            </div>
          {%- when 'richtext_block' -%}
            <div class="fm-care-p-{{ section.id }}" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>
          {%- when 'card_block' -%}
            <div class="fm-care-card-{{ section.id }}" {{ block.shopify_attributes }}>
              <div class="fm-care-card-title-{{ section.id }}">{{ block.settings.title }}</div>
              <div class="fm-care-card-desc-{{ section.id }}">{{ block.settings.description }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    {%- else -%}
<h2 class="fm-care-h2">General care</h2>
    <p class="fm-care-p">Farsh Mahal rugs are hand-tufted using 100% premium New Zealand wool and natural fibres. With thoughtful everyday care, your rug will grow more beautiful with age.</p>
    <ul class="fm-care-ul">
      <li><strong>Rotation:</strong> Rotate your rug 180 degrees every 6 to 12 months to ensure even wear and balanced exposure to natural sunlight.</li>
      <li><strong>Spills & Spot Cleaning:</strong> Blot immediate spills with a clean, dry white cotton cloth. Never rub or scrub the fibres vigorously, as this can push stains deeper or damage the pile structure.</li>
      <li><strong>Professional Cleaning:</strong> We recommend professional rug cleaning by an experienced wool rug specialist every 1 to 2 years, depending on household traffic.</li>
    </ul>

    <h2 class="fm-care-h2">Vacuuming</h2>
    <p class="fm-care-p">Regular, gentle vacuuming is the single most effective way to preserve wool rugs and manage natural initial shedding.</p>
    <ul class="fm-care-ul">
      <li>Use a canister vacuum or vacuum with the beater brush disengaged (suction only).</li>
      <li>Vacuum on low to medium power at least twice a week during the initial few months.</li>
      <li>Initial shedding is completely normal for handcrafted wool rugs and will naturally taper off with routine vacuuming.</li>
    </ul>

    <h2 class="fm-care-h2">Storing rugs safely</h2>
    <p class="fm-care-p">If storing your rug temporarily during a move or renovation:</p>
    <ul class="fm-care-ul">
      <li>Clean and dry the rug thoroughly before wrapping.</li>
      <li>Always roll the rug with the pile facing inward — never fold wool rugs, as folding can create permanent creases in the backing.</li>
      <li>Wrap in breathable cotton sheeting or heavy kraft paper. Avoid airtight plastic wrap, which can trap ambient moisture and cause mildew.</li>
      <li>Store horizontally off the floor in a cool, dry, well-ventilated room away from direct heat sources.</li>
    </ul>

    <h2 class="fm-care-h2">Sizing — how to pick the right rug</h2>
    <p class="fm-care-p">Choosing the correct proportion anchors your space and creates architectural harmony throughout the room.</p>

    <div class="fm-care-card-grid">
      <div class="fm-care-card">
        <div class="fm-care-card-title">Living Room</div>
        <div class="fm-care-card-desc">
          <strong>All Legs On:</strong> 9'×12' or 10'×14' creates a generous island.<br><br>
          <strong>Front Legs On:</strong> 8'×10' connects sofas and accent chairs seamlessly.<br><br>
          <strong>Coffee Table Only:</strong> 5'×8' or 6'×9' for compact spaces.
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FM Care Guide",
  "tag": "section",
  "class": "section-fm-care",
  "settings": [
    {
      "type": "header",
      "content": "Page Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Guide"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Rug Care & Selection Guide"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everything you need to look after your rug — and choose the right size for your room."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FBF8F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1B4332"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle / Answer Color",
      "default": "rgba(27, 67, 50, 0.75)"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#C1914E"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border / Divider Color",
      "default": "rgba(27, 67, 50, 0.12)"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_header",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Header Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_header",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Header Padding Bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_body",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Body Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_body",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Body Padding Bottom",
      "default": 100
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Header Container Width",
      "default": 1100
    },
    {
      "type": "range",
      "id": "body_container_width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Body Container Width",
      "default": 900
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Title Font Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "subtitle_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Font Size",
      "default": 15
    },
    {
      "type": "range",
      "id": "body_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Body Font Size",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "heading_block",
      "name": "Heading / Category",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading Text",
          "default": "Section Heading"
        }
      ]
    },
    {
      "type": "qa_block",
      "name": "Q&A / Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question text here"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Answer text goes here."
        }
      ]
    },
    {
      "type": "richtext_block",
      "name": "Rich Text / Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Content goes here.</p>"
        }
      ]
    },
    {
      "type": "card_block",
      "name": "Feature / Benefit Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description",
          "default": "Description of the feature."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FM Care Guide"
    }
  ]
}
{% endschema %}
