<!-- Farsh Mahal - The Making / Craftsmanship Banner -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

{%- style -%}
  .fm-craft-section-{{ section.id }} {
    position: relative;
    background-color: {{ section.settings.bg_color | default: '#1B4332' }};
    color: #F7F2ED;
    padding-top: {{ section.settings.padding_top | default: 96 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 96 }}px;
    overflow: hidden;
  }
  @media screen and (max-width: 767px) {
    .fm-craft-section-{{ section.id }} {
      padding-top: 64px;
      padding-bottom: 64px;
    }
  }

  .fm-craft-container-{{ section.id }} {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 48px;
    align-items: center;
    box-sizing: border-box;
  }
  @media screen and (min-width: 768px) {
    .fm-craft-container-{{ section.id }} {
      padding: 0 48px;
      grid-template-columns: repeat(12, 1fr);
      column-gap: 48px;
    }
  }
  @media screen and (min-width: 1024px) {
    .fm-craft-container-{{ section.id }} {
      column-gap: 64px;
    }
  }

  .fm-craft-text-col {
    grid-column: span 12;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  @media screen and (min-width: 768px) {
    .fm-craft-text-col {
      grid-column: span 6;
    }
  }

  .fm-craft-eyebrow {
    font-family: 'Manrope', sans-serif !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 0.32em !important;
    text-transform: uppercase !important;
    color: #C1914E !important;
    margin: 0 0 16px 0 !important;
    display: block !important;
    line-height: 1.4 !important;
  }

  .fm-craft-heading {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: clamp(38px, 5.5vw, 68px) !important;
    font-weight: 400 !important;
    color: #FFFFFF !important;
    line-height: 1.02 !important;
    letter-spacing: -0.02em !important;
    margin: 0 0 24px 0 !important;
  }
  .fm-craft-heading span,
  .fm-craft-heading .fm-craft-gold {
    color: #C1914E !important;
    font-style: italic !important;
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: 1em !important;
    font-weight: 400 !important;
    display: inline !important;
  }

  .fm-craft-body,
  .fm-craft-body p {
    font-family: 'Manrope', sans-serif !important;
    font-size: 15px !important;
    line-height: 1.7 !important;
    color: rgba(247, 242, 237, 0.85) !important;
    max-width: 520px !important;
    margin: 0 0 36px 0 !important;
    font-weight: 400 !important;
  }

  .fm-craft-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 36px;
    margin-bottom: 44px;
    width: 100%;
    max-width: 440px;
  }
  .fm-craft-stat-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .fm-craft-stat-val {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: 36px !important;
    color: #C1914E !important;
    line-height: 1.0 !important;
    font-weight: 400 !important;
  }
  .fm-craft-stat-lbl {
    font-family: 'Manrope', sans-serif !important;
    font-size: 11px !important;
    letter-spacing: 0.20em !important;
    text-transform: uppercase !important;
    color: rgba(247, 242, 237, 0.65) !important;
    font-weight: 500 !important;
    line-height: 1.3 !important;
  }

  .fm-craft-btn {
    display: inline-flex !important;
    align-items: center !important;
    gap: 12px !important;
    padding: 16px 36px !important;
    background-color: transparent !important;
    border: 1px solid rgba(255, 255, 255, 0.45) !important;
    color: #FFFFFF !important;
    font-family: 'Manrope', sans-serif !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 0.28em !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    transition: all 0.3s ease !important;
  }
  .fm-craft-btn span {
    color: #FFFFFF !important;
  }
  .fm-craft-btn svg {
    color: #FFFFFF !important;
    stroke: #FFFFFF !important;
  }
  .fm-craft-btn:hover {
    background-color: #FFFFFF !important;
    color: #1B4332 !important;
    border-color: #FFFFFF !important;
  }
  .fm-craft-btn:hover span {
    color: #1B4332 !important;
  }
  .fm-craft-btn:hover svg {
    color: #1B4332 !important;
    stroke: #1B4332 !important;
  }

  .fm-craft-img-col {
    grid-column: span 12;
  }
  @media screen and (min-width: 768px) {
    .fm-craft-img-col {
      grid-column: span 6;
    }
  }

  .fm-craft-img-wrap {
    position: relative;
    aspect-ratio: 5 / 6;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.2);
  }
  .fm-craft-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fm-craft-img-wrap:hover .fm-craft-img {
    transform: scale(1.04);
  }
{%- endstyle -%}

<section class="fm-craft-section-{{ section.id }}" aria-label="Craftsmanship">
  <div class="fm-craft-container-{{ section.id }}">
    <div class="fm-craft-text-col">
      <span class="fm-craft-eyebrow">{{ section.settings.eyebrow | default: section.settings.tagline | default: 'THE MAKING' }}</span>
      <h2 class="fm-craft-heading">
        Crafted by <span class="fm-craft-gold">skilled</span><br>
        <span class="fm-craft-gold">hands.</span>
      </h2>
      <div class="fm-craft-body">
        <p>Behind every rug are hours of thoughtful craftsmanship. From the first sketch to the final finishing touches, every detail is considered — one rug at a time.</p>
      </div>

      <div class="fm-craft-stats-grid">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="fm-craft-stat-item" {{ block.shopify_attributes }}>
              <span class="fm-craft-stat-val">{{ block.settings.stat_value }}</span>
              <span class="fm-craft-stat-lbl">{{ block.settings.stat_label }}</span>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="fm-craft-stat-item">
            <span class="fm-craft-stat-val">120+</span>
            <span class="fm-craft-stat-lbl">HOURS PER RUG</span>
          </div>
          <div class="fm-craft-stat-item">
            <span class="fm-craft-stat-val">4 gen</span>
            <span class="fm-craft-stat-lbl">ARTISAN FAMILIES</span>
          </div>
          <div class="fm-craft-stat-item">
            <span class="fm-craft-stat-val">100%</span>
            <span class="fm-craft-stat-lbl">HAND-TUFTED</span>
          </div>
          <div class="fm-craft-stat-item">
            <span class="fm-craft-stat-val">8-12 wk</span>
            <span class="fm-craft-stat-lbl">CUSTOM LEAD TIME</span>
          </div>
        {%- endif -%}
      </div>

      {%- assign btn_text = section.settings.btn_label | default: section.settings.button_label | default: 'LEARN ABOUT OUR CRAFT' -%}
      {%- assign btn_url = section.settings.btn_link | default: section.settings.button_link | default: '/pages/our-story' -%}
      {%- if btn_text != blank -%}
        <a href="{{ btn_url }}" class="fm-craft-btn">
          <span>{{ btn_text }}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="fm-craft-img-col">
      <div class="fm-craft-img-wrap">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="Crafted by skilled hands" class="fm-craft-img" loading="lazy">
        {%- elsif section.settings.asset_image != blank -%}
          <img src="{{ section.settings.asset_image | asset_url }}" alt="Crafted by skilled hands" class="fm-craft-img" loading="lazy">
        {%- else -%}
          <img src="{{ 'fm-artisan-loom.jpg' | asset_url }}" alt="Artisan tufting a rug on a loom" class="fm-craft-img" loading="lazy">
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FM Craftsmanship Banner",
  "tag": "section",
  "class": "section-fm-craftsmanship-banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE MAKING"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Crafted by"
    },
    {
      "type": "text",
      "id": "title_italic",
      "label": "Title (Italic Line 1)",
      "default": "skilled"
    },
    {
      "type": "text",
      "id": "title_italic_2",
      "label": "Title (Italic Line 2)",
      "default": "hands."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body Description",
      "default": "<p>Behind every rug are hours of thoughtful craftsmanship. From the first sketch to the final finishing touches, every detail is considered — one rug at a time.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "asset_image",
      "label": "Asset Image Name",
      "default": "fm-artisan-loom.jpg"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "LEARN ABOUT OUR CRAFT"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1B4332"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding Top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "stat_item",
      "name": "Statistic Item",
      "settings": [
        {
          "type": "text",
          "id": "stat_value",
          "label": "Stat Value",
          "default": "120+"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Stat Label",
          "default": "HOURS PER RUG"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Stat Item",
      "settings": [
        {
          "type": "text",
          "id": "stat_value",
          "label": "Stat Value",
          "default": "120+"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Stat Label",
          "default": "HOURS PER RUG"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FM Craftsmanship Banner"
    }
  ]
}
{% endschema %}
