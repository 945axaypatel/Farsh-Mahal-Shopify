<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">

{%- style -%}
  /* Global Stacking Context Elevation for Mega Menu */
  :root {
    --fm-header-zindex: 999999;
  }
  .shopify-section-group-header-group {
    position: sticky !important;
    top: 0 !important;
    z-index: 999999 !important;
  }
  .section-fm-header {
    position: sticky !important;
    top: 0 !important;
    z-index: 999999 !important;
  }
  .fm-header-wrapper {
    position: sticky !important;
    top: 0 !important;
    z-index: 999999 !important;
    background-color: #FBF8F4 !important;
    background: #FBF8F4 !important;
    border-bottom: 1px solid rgba(27, 67, 50, 0.08);
    transition: var(--fm-transition);
  }

  .fm-header-wrapper {
    position: sticky;
    top: 0;
    z-index: 99999 !important;
    background-color: #FBF8F4 !important;
    background: #FBF8F4 !important;
    border-bottom: 1px solid rgba(27, 67, 50, 0.08);
    transition: var(--fm-transition);
  }
  .fm-header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
    height: 76px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  /* Left Navigation */
  .fm-header-left {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.2vw, 32px);
  }
  .fm-nav-link {
    font-family: var(--fm-font-sans);
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: {{ section.settings.nav_color | default: '#1B4332' }};
    text-decoration: none;
    transition: var(--fm-transition);
    position: relative;
    padding: 6px 0;
  }
  .fm-nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1.5px;
    background-color: var(--fm-gold);
    transition: width 0.3s ease;
  }
  .fm-nav-link:hover {
    color: var(--fm-gold);
  }
  .fm-nav-link:hover::after {
    width: 100%;
  }

  /* Center Logo */
  .fm-header-center {
    text-align: center;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .fm-brand-logo-link {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .fm-brand-wordmark {
    font-family: var(--fm-font-serif) !important;
    font-size: clamp(2.4rem, 3vw, 3.2rem);
    letter-spacing: 0.22em;
    color: {{ section.settings.logo_color | default: '#1B4332' }} !important;
    text-transform: uppercase;
    font-weight: 500;
    line-height: 1;
    margin: 0;
    transition: var(--fm-transition);
  }
  .fm-brand-wordmark:hover {
    color: var(--fm-gold) !important;
  }

  /* Right Navigation & Utilities */
  .fm-header-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(16px, 2vw, 28px);
  }
  .fm-cart-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--fm-font-sans);
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: {{ section.settings.nav_color | default: '#1B4332' }};
    text-decoration: none;
    transition: var(--fm-transition);
  }
  .fm-cart-link:hover {
    color: var(--fm-gold);
  }

  /* Mobile Controls */
  .fm-mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: var(--fm-forest);
  }
  .fm-mobile-drawer {
    display: none;
    position: fixed;
    top: 76px;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--fm-ivory);
    z-index: 99;
    padding: 32px 24px;
    overflow-y: auto;
    border-top: 1px solid var(--fm-border-light);
    transform: translateY(-100%);
    opacity: 0;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fm-mobile-drawer.open {
    display: block;
    transform: translateY(0);
    opacity: 1;
  }
  .fm-mobile-menu-list {
    list-style: none;
    padding: 0;
    margin: 0 0 32px 0;
  }
  .fm-mobile-menu-list li {
    margin-bottom: 20px;
    border-bottom: 1px solid var(--fm-border-light);
    padding-bottom: 16px;
  }
  .fm-mobile-menu-list a {
    font-family: var(--fm-font-serif);
    font-size: 2.4rem;
    color: var(--fm-forest);
    text-decoration: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  @media screen and (max-width: 989px) {
    .fm-header-container {
      grid-template-columns: auto 1fr auto;
      height: 68px;
      padding: 0 16px;
    }
    .fm-header-left .fm-nav-link,
    .fm-header-right .fm-nav-link {
      display: none;
    }
    .fm-mobile-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .fm-brand-wordmark {
      font-size: 2.2rem;
      letter-spacing: 0.16em;
    }
    .fm-cart-link span.fm-cart-text {
      display: none;
    }
  }

  .cart-count-bubble,
  #cart-icon-bubble .cart-count-bubble {
    display: none !important;
    visibility: hidden !important;
  }
  /* ----------------------------------------------------
     Luxury Slide-Down Search Bar (farshmahal.com 100% exact)
  ---------------------------------------------------- */
    /* ----------------------------------------------------
     Luxury Shop Mega Menu (farshmahal.com 100% exact)
  ---------------------------------------------------- */
  .fm-nav-item-shop {
    position: static;
    display: inline-flex;
    align-items: center;
  }

  .fm-mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    background-color: #FBF8F4 !important;
    background: #FBF8F4 !important;
    border-top: 1px solid rgba(27, 67, 50, 0.08);
    border-bottom: 1px solid rgba(27, 67, 50, 0.08);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.15);
    z-index: 999999 !important;
    display: none;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  .fm-mega-menu.is-active {
    display: block !important;
    opacity: 1 !important;
    transform: translateY(0) !important;
  }

  .fm-mega-menu-inner {
    max-width: 1500px;
    margin: 0 auto;
    padding: 56px 40px;
    box-sizing: border-box;
    background-color: #FBF8F4 !important;
    background: #FBF8F4 !important;
  }

  .fm-mega-grid,
  .fm-mega-col-collections,
  .fm-mega-col-sizes {
    background-color: #FBF8F4 !important;
    background: #FBF8F4 !important;
  }

  .fm-mega-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 64px;
  }

  .fm-mega-col-collections {
    grid-column: span 5;
  }

  .fm-mega-col-sizes {
    grid-column: span 7;
  }

  .fm-mega-eyebrow {
    font-family: 'Manrope', sans-serif !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 0.32em !important;
    text-transform: uppercase !important;
    color: #C9A24D !important;
    display: block !important;
    margin-bottom: 24px !important;
    line-height: 1.2 !important;
  }

  .fm-mega-collections-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .fm-mega-col-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid rgba(27, 67, 50, 0.08);
    padding-bottom: 12px;
    text-decoration: none !important;
    transition: border-color 0.2s ease;
  }
  .fm-mega-col-item:hover {
    border-bottom-color: #1B4332;
  }

  .fm-mega-col-name {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: 22px !important;
    line-height: 1.15 !important;
    color: #1B4332 !important;
    font-weight: 400 !important;
    transition: color 0.2s ease;
  }
  .fm-mega-col-item:hover .fm-mega-col-name {
    color: #C9A24D !important;
  }

  .fm-mega-col-note {
    font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif !important;
    font-style: italic !important;
    font-size: 13px !important;
    color: rgba(27, 67, 50, 0.55) !important;
    text-align: right;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .fm-mega-col-item:hover .fm-mega-col-note {
    color: #1B4332 !important;
  }

  .fm-mega-all-link {
    margin-top: 32px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Manrope', sans-serif !important;
    font-size: 11px !important;
    letter-spacing: 0.24em !important;
    text-transform: uppercase !important;
    color: #1B4332 !important;
    text-decoration: none !important;
    font-weight: 600 !important;
    transition: all 0.2s ease;
  }
  .fm-mega-all-link:hover {
    color: #C9A24D !important;
    gap: 12px;
  }

  .fm-mega-sizes-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    row-gap: 16px;
    column-gap: 24px;
  }

  .fm-mega-size-link {
    font-family: 'Manrope', sans-serif !important;
    font-size: 13.5px !important;
    color: #1B4332 !important;
    text-decoration: none !important;
    font-weight: 400 !important;
    transition: color 0.2s ease;
    display: inline-block;
  }
  .fm-mega-size-link:hover {
    color: #C9A24D !important;
  }

  .fm-mega-size-guide-text {
    font-family: 'Manrope', sans-serif !important;
    font-size: 12px !important;
    line-height: 1.6 !important;
    color: rgba(27, 67, 50, 0.6) !important;
    margin-top: 32px !important;
    max-width: 320px;
  }

  .fm-mega-guide-link {
    color: #1B4332 !important;
    text-decoration: underline !important;
    text-underline-offset: 3px !important;
    transition: color 0.2s ease;
  }
  .fm-mega-guide-link:hover {
    color: #C9A24D !important;
  }

  .fm-header-search-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: #1B4332;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
  }
  .fm-header-search-btn:hover {
    color: #C9A24D;
  }

  .fm-header-search-bar {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    background-color: #FBF8F4 !important;
    background: #FBF8F4 !important;
    border-top: 1px solid rgba(27, 67, 50, 0.08);
    border-bottom: 1px solid rgba(27, 67, 50, 0.08);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    z-index: 999;
  }

  .fm-search-bar-inner {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
    position: relative;
  }
  @media (min-width: 768px) {
    .fm-search-bar-inner {
      padding: 0 40px;
    }
  }

  .fm-search-form {
    margin: 0;
    padding: 16px 0;
    width: 100%;
  }
  @media (min-width: 768px) {
    .fm-search-form {
      padding: 22px 0;
    }
  }

  .fm-search-input-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
  }

  .fm-search-icon {
    color: #1B4332;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  .fm-search-input {
    flex: 1;
    background: transparent !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 15px !important;
    color: #1B4332 !important;
    padding: 0 !important;
    margin: 0 !important;
    height: auto !important;
    letter-spacing: 0.01em;
  }
  @media (min-width: 768px) {
    .fm-search-input {
      font-size: 17px !important;
    }
  }
  .fm-search-input::placeholder {
    color: rgba(27, 67, 50, 0.45) !important;
    font-weight: 400;
  }

  .fm-search-close-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: rgba(27, 67, 50, 0.6);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .fm-search-close-btn:hover {
    color: #1B4332;
    transform: scale(1.1);
  }

  .fm-search-results-dropdown {
    position: absolute;
    top: 100%;
    left: 24px;
    right: 24px;
    background: #FBF8F4;
    border: 1px solid rgba(27, 67, 50, 0.12);
    border-top: none;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
    max-height: 440px;
    overflow-y: auto;
    z-index: 1000;
    padding: 16px 20px;
    box-sizing: border-box;
  }
  @media (min-width: 768px) {
    .fm-search-results-dropdown {
      left: 40px;
      right: 40px;
      padding: 20px 28px;
    }
  }

  .fm-search-result-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(27, 67, 50, 0.06);
    text-decoration: none !important;
    transition: background-color 0.2s ease;
  }
  .fm-search-result-item:last-child {
    border-bottom: none;
  }
  .fm-search-result-thumb {
    width: 48px;
    height: 60px;
    object-fit: cover;
    background-color: #EDE8DE;
    flex-shrink: 0;
  }
  .fm-search-result-info {
    flex: 1;
  }
  .fm-search-result-title {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: 16px !important;
    color: #1B4332 !important;
    margin: 0 0 2px 0 !important;
  }
  .fm-search-result-item:hover .fm-search-result-title {
    color: #C9A24D !important;
  }
  .fm-search-result-series {
    font-family: 'Manrope', sans-serif !important;
    font-size: 10px !important;
    letter-spacing: 0.2em !important;
    text-transform: uppercase !important;
    color: #C9A24D !important;
    font-weight: 600 !important;
  }
  .fm-search-result-price {
    font-family: 'Playfair Display', serif !important;
    font-size: 14px !important;
    color: #1B4332 !important;
    margin-left: auto;
    font-weight: 500;
  }
{%- endstyle -%}

<header class="fm-header-wrapper" id="FarshMahalHeader">
  <div class="fm-header-container">
    <!-- Mobile Hamburger Toggle & Left Menu (Desktop) -->
    <div class="fm-header-left">
      <button type="button" class="fm-mobile-toggle" id="FmMobileMenuBtn" aria-label="Toggle Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <nav class="fm-header-left-nav" aria-label="Main Navigation Left">
        <div style="display: flex; gap: clamp(14px, 2vw, 28px);">
          {%- if section.settings.left_menu != blank -%}
            {%- for link in linklists[section.settings.left_menu].links -%}
              <a href="{{ link.url }}" class="fm-nav-link">{{ link.title }}</a>
            {%- endfor -%}
          {%- else -%}
            <div class="fm-nav-item fm-nav-item-shop">
              <a href="/collections/all" class="fm-nav-link" id="FmShopNavTrigger" data-testid="nav-shop">Shop</a>
            </div>
            <a href="/collections" class="fm-nav-link">Collections</a>
            <a href="/pages/custom-rugs" class="fm-nav-link">Custom</a>
            <a href="/pages/trade" class="fm-nav-link">Trade</a>
          {%- endif -%}
        </div>
      </nav>
    </div>

    <!-- Center Wordmark Logo -->
    <div class="fm-header-center">
      <a href="{{ routes.root_url }}" class="fm-brand-logo-link" aria-label="Farsh Mahal Homepage">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" style="max-height: 48px; width: auto;">
        {%- else -%}
          <span class="fm-brand-wordmark">{{ section.settings.brand_name | default: 'FARSH MAHAL' }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Right Navigation & Tools -->
    <div class="fm-header-right">
      <nav class="fm-header-right-nav" aria-label="Main Navigation Right">
        <div style="display: flex; gap: clamp(14px, 2vw, 28px); align-items: center;">
          {%- if section.settings.right_menu != blank -%}
            {%- for link in linklists[section.settings.right_menu].links -%}
              <a href="{{ link.url }}" class="fm-nav-link">{{ link.title }}</a>
            {%- endfor -%}
          {%- else -%}
            <a href="/blogs/news" class="fm-nav-link">Journal</a>
            <a href="/pages/story" class="fm-nav-link">Story</a>
          {%- endif -%}
        </div>
      </nav>

      <!-- Search Tool -->
      <!-- Luxury Search Trigger -->
      <button type="button" class="fm-header-search-btn" id="FmSearchTrigger" aria-label="Search" data-testid="nav-search-trigger">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Cart Button with Count -->
      <a href="{{ routes.cart_url }}" class="fm-cart-link" id="cart-icon-bubble" aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="fm-cart-text">Cart ({{ cart.item_count }})</span>
      </a>
    </div>
  </div>

  <!-- Mobile Dropdown Drawer -->
  <div class="fm-mobile-drawer" id="FmMobileDrawer">
    <ul class="fm-mobile-menu-list">
      <li><a href="/collections/all">Shop All Rugs <span>&rarr;</span></a></li>
      <li><a href="/collections">Collections <span>&rarr;</span></a></li>
      <li><a href="/pages/custom-rugs">Custom Rugs <span>&rarr;</span></a></li>
      <li><a href="/pages/trade">Trade Programme <span>&rarr;</span></a></li>
      <li><a href="/blogs/news">Journal & Essays <span>&rarr;</span></a></li>
      <li><a href="/pages/story">Our Story <span>&rarr;</span></a></li>
      <li><a href="/pages/contact">Contact & Concierge <span>&rarr;</span></a></li>
      <li><a href="/pages/faq">FAQ & Assistance <span>&rarr;</span></a></li>
      <li><a href="/pages/rug-care-selection-guide">Rug Care & Selection Guide <span>&rarr;</span></a></li>
      <li><a href="/pages/anti-slip-guide">Anti-Slip Guide <span>&rarr;</span></a></li>
    </ul>

    <div style="padding-top: 16px; border-top: 1px solid var(--fm-border);">
      <p style="font-size: 1.3rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fm-gold); margin-bottom: 8px; font-weight: 600;">Direct Concierge</p>
      <a href="mailto:{{ section.settings.contact_email | default: 'farshmahal@gmail.com' }}" style="color: var(--fm-forest); font-size: 1.5rem; text-decoration: none; display: block; margin-bottom: 6px;">{{ section.settings.contact_email | default: 'farshmahal@gmail.com' }}</a>
      <a href="tel:{{ section.settings.contact_phone | default: '+916351043735' }}" style="color: var(--fm-forest); font-size: 1.45rem; text-decoration: none;">{{ section.settings.contact_phone | default: '+91 6351043735' }}</a>
    </div>
  </div>
    <!-- Exact Luxury Shop Mega Menu matching screenshot & farshmahal.com -->
  <div class="fm-mega-menu" id="FmMegaMenuShop" data-testid="mega-menu-shop">
    <div class="fm-mega-menu-inner">
      <div class="fm-mega-grid">
        <!-- Left: Collections Column (5 cols) -->
        <div class="fm-mega-col-collections">
          <span class="fm-mega-eyebrow">COLLECTIONS</span>
          <ul class="fm-mega-collections-list">
            <li>
              <a href="/collections/organic-terrain" class="fm-mega-col-item">
                <span class="fm-mega-col-name">Organic Terrain</span>
                <span class="fm-mega-col-note">Flowing landscapes underfoot</span>
              </a>
            </li>
            <li>
              <a href="/collections/modern-grid" class="fm-mega-col-item">
                <span class="fm-mega-col-name">Modern Grid</span>
                <span class="fm-mega-col-note">Architectural clarity, refined</span>
              </a>
            </li>
            <li>
              <a href="/collections/retro-geometry" class="fm-mega-col-item">
                <span class="fm-mega-col-name">Retro Geometry</span>
                <span class="fm-mega-col-note">Confident mid-century forms</span>
              </a>
            </li>
            <li>
