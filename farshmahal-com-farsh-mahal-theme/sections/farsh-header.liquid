    function openSearch() {
      if (searchBar) {
        searchBar.style.display = 'block';
        if (searchInput) {
          setTimeout(function() { searchInput.focus(); }, 100);
        }
      }
    }

    function closeSearch() {
      if (searchBar) {
        searchBar.style.display = 'none';
        if (searchInput) searchInput.value = '';
        if (searchResults) {
          searchResults.style.display = 'none';
          searchResults.innerHTML = '';
        }
      }
    }

    if (searchTrigger) {
      searchTrigger.addEventListener('click', function(e) {
        e.preventDefault();
        if (searchBar.style.display === 'none' || !searchBar.style.display) {
          openSearch();
        } else {
          closeSearch();
        }
      });
    }

    if (searchClose) {
      searchClose.addEventListener('click', function(e) {
        e.preventDefault();
        closeSearch();
      });
    }

    // Escape key closes search
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && searchBar && searchBar.style.display !== 'none') {
        closeSearch();
      }
    });

    // Form submit -> redirect to /collections/all?q=query or /pages/shop?q=query
    if (searchForm) {
      searchForm.addEventListener('submit', function(e) {
        e.preventDefault();
        var q = searchInput ? searchInput.value.trim() : '';
        if (q) {
          window.location.href = '/collections/all?q=' + encodeURIComponent(q);
        }
      });
    }

    // Live search instant lookup
    if (searchInput && searchResults) {
      searchInput.addEventListener('input', function() {
        var q = searchInput.value.trim().toLowerCase();
        if (q.length < 2) {
          searchResults.style.display = 'none';
          searchResults.innerHTML = '';
          return;
        }

        var matches = catalogProducts.filter(function(p) {
          var t = (p.title || '').toLowerCase();
          var s = (p.series || '').toLowerCase();
          var h = (p.handle || '').toLowerCase();
          return t.indexOf(q) !== -1 || s.indexOf(q) !== -1 || h.indexOf(q) !== -1;
        }).slice(0, 5);

        if (matches.length > 0) {
          var html = '<div style="font-family: Manrope, sans-serif; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: #C9A24D; margin-bottom: 12px; font-weight: 600;">Matching Rugs (' + matches.length + ')</div>';
          matches.forEach(function(item) {
            var formattedPrice = '$' + (typeof item.price === 'number' ? item.price.toLocaleString('en-US') : item.price);
            html += '<a href="' + item.url + '" class="fm-search-result-item">' +
                      '<img src="' + item.image + '" alt="' + item.title + '" class="fm-search-result-thumb">' +
                      '<div class="fm-search-result-info">' +
                        '<h4 class="fm-search-result-title">' + item.title + '</h4>' +
                        '<span class="fm-search-result-series">' + item.series + '</span>' +
                      '</div>' +
                      '<div class="fm-search-result-price">' + formattedPrice + '</div>' +
                    '</a>';
          });
          html += '<a href="/collections/all?q=' + encodeURIComponent(q) + '" style="display: block; text-align: center; padding-top: 14px; font-family: Manrope, sans-serif; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: #1B4332; font-weight: 600; text-decoration: underline;">View All Results &rarr;</a>';
          searchResults.innerHTML = html;
          searchResults.style.display = 'block';
        } else {
          searchResults.innerHTML = '<div style="padding: 12px 0; color: rgba(27,67,50,0.6); font-family: Manrope, sans-serif; font-size: 14px;">No matching rugs found for "' + q + '". Press Enter to search all.</div>';
          searchResults.style.display = 'block';
        }
      });
    }
  });
</script>

