    var shopNav = document.getElementById('FmShopNavTrigger');
    var megaMenu = document.getElementById('FmMegaMenuShop');
    var header = document.getElementById('FarshMahalHeader');
    var megaTimeout = null;

    function showMega() {
      clearTimeout(megaTimeout);
      if (megaMenu) {
        megaMenu.classList.add('is-active');
      }
    }

    function hideMega() {
      clearTimeout(megaTimeout);
      megaTimeout = setTimeout(function() {
        if (megaMenu) {
          megaMenu.classList.remove('is-active');
        }
      }, 150);
    }

    if (shopNav && megaMenu) {
      shopNav.addEventListener('mouseenter', showMega);
      shopNav.addEventListener('focus', showMega);
