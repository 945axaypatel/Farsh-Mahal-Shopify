{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

<style>
  .fm-terms-page-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FBF8F4' }};
    color: {{ section.settings.text_color | default: '#1B4332' }};
    min-height: 100vh;
  }
  .fm-terms-header-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_header | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom_header | default: 40 }}px;
    border-bottom: 1px solid {{ section.settings.border_color | default: 'rgba(27, 67, 50, 0.12)' }};
  }
  .fm-terms-header-inner-{{ section.id }} {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: {{ section.settings.header_alignment | default: 'left' }};
  }
  .fm-terms-eyebrow-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#1B4332' }};
    font-weight: 500;
  }
  .fm-terms-title-{{ section.id }} {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 5.5vw, {{ section.settings.title_font_size | default: 64 }}px);
    line-height: 1.05;
    color: {{ section.settings.text_color | default: '#1B4332' }};
    letter-spacing: -0.02em;
    margin-top: 16px;
    margin-bottom: 0;
    max-width: 850px;
    font-weight: 400;
  }
  .fm-terms-subtitle-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.subtitle_font_size | default: 15 }}px;
    line-height: 1.65;
    color: {{ section.settings.subtitle_color | default: 'rgba(27, 67, 50, 0.75)' }};
    margin-top: 24px;
    margin-bottom: 0;
    max-width: 680px;
  }
  .fm-terms-body-{{ section.id }} {
    max-width: {{ section.settings.body_container_width | default: 900 }}px;
    margin: 0 auto;
    padding-top: {{ section.settings.padding_top_body | default: 64 }}px;
    padding-bottom: {{ section.settings.padding_bottom_body | default: 100 }}px;
    padding-left: 24px;
    padding-right: 24px;
  }
  .fm-terms-h2-{{ section.id }},
  .fm-terms-cat-title-{{ section.id }} {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(24px, 3vw, 34px);
    color: {{ section.settings.text_color | default: '#1B4332' }};
    line-height: 1.15;
    margin-top: 56px;
    margin-bottom: 20px;
    font-weight: 400;
  }
  .fm-terms-h2-{{ section.id }}:first-of-type,
  .fm-terms-cat-title-{{ section.id }}:first-of-type {
    margin-top: 0;
  }
  .fm-terms-h3-{{ section.id }},
  .fm-terms-subcat-title-{{ section.id }} {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(18px, 2.2vw, 22px);
    color: {{ section.settings.text_color | default: '#1B4332' }};
    line-height: 1.25;
    margin-top: 40px;
    margin-bottom: 14px;
    font-weight: 400;
  }
  .fm-terms-p-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.body_font_size | default: 15 }}px;
    color: {{ section.settings.text_color | default: 'rgba(27, 67, 50, 0.85)' }};
    line-height: 1.75;
    margin-bottom: 16px;
  }
  .fm-terms-ul-{{ section.id }} {
    list-style: disc;
    padding-left: 24px;
    margin-bottom: 24px;
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.body_font_size | default: 15 }}px;
    line-height: 1.8;
    color: {{ section.settings.text_color | default: 'rgba(27, 67, 50, 0.85)' }};
  }
  .fm-terms-ul-{{ section.id }} li {
    margin-bottom: 8px;
  }
  .fm-terms-ul-{{ section.id }} li::marker {
    color: {{ section.settings.accent_color | default: '#C1914E' }};
  }
  .fm-terms-qa-{{ section.id }},
  .fm-terms-item-{{ section.id }} {
    border-top: 1px solid {{ section.settings.border_color | default: 'rgba(27, 67, 50, 0.1)' }};
    padding-top: 24px;
    margin-top: 24px;
  }
  .fm-terms-h2-{{ section.id }} + .fm-terms-qa-{{ section.id }},
  .fm-terms-cat-title-{{ section.id }} + .fm-terms-item-{{ section.id }},
  .fm-terms-h3-{{ section.id }} + .fm-terms-qa-{{ section.id }},
  .fm-terms-subcat-title-{{ section.id }} + .fm-terms-item-{{ section.id }} {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }
  .fm-terms-q-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: {{ section.settings.text_color | default: '#1B4332' }};
    margin-bottom: 12px;
    line-height: 1.4;
  }
  .fm-terms-a-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.body_font_size | default: 15 }}px;
    color: {{ section.settings.subtitle_color | default: 'rgba(27, 67, 50, 0.75)' }};
    line-height: 1.75;
  }
  .fm-terms-link-{{ section.id }} {
    color: {{ section.settings.text_color | default: '#1B4332' }};
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .fm-terms-link-{{ section.id }}:hover {
    color: {{ section.settings.accent_color | default: '#C1914E' }};
  }
  .fm-terms-card-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin: 32px 0 48px 0;
  }
  .fm-terms-card-{{ section.id }} {
    background: #FFFFFF;
    border: 1px solid {{ section.settings.border_color | default: 'rgba(27, 67, 50, 0.1)' }};
    padding: 24px;
    border-radius: 2px;
  }
  .fm-terms-card-title-{{ section.id }} {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 18px;
    color: {{ section.settings.text_color | default: '#1B4332' }};
    margin-bottom: 8px;
  }
  .fm-terms-card-desc-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: {{ section.settings.subtitle_color | default: 'rgba(27, 67, 50, 0.75)' }};
  }
</style>

<div class="fm-terms-page-{{ section.id }}" data-testid="content-page-fm-terms">
  <header class="fm-terms-header-{{ section.id }}">
    <div class="fm-terms-header-inner-{{ section.id }}">
      <div class="fm-terms-eyebrow-{{ section.id }}">{{ section.settings.eyebrow | default: 'Legal' }}</div>
      <h1 class="fm-terms-title-{{ section.id }}">{{ section.settings.title | default: 'Terms & Conditions' }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="fm-terms-subtitle-{{ section.id }}">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
  </header>

  <div class="fm-terms-body-{{ section.id }}">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading_block' -%}
            <h2 class="fm-terms-h2-{{ section.id }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'qa_block' -%}
            <div class="fm-terms-qa-{{ section.id }}" {{ block.shopify_attributes }}>
              <div class="fm-terms-q-{{ section.id }}">{{ block.settings.question }}</div>
              <div class="fm-terms-a-{{ section.id }}">{{ block.settings.answer }}</div>
            </div>
          {%- when 'richtext_block' -%}
            <div class="fm-terms-p-{{ section.id }}" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>
          {%- when 'card_block' -%}
            <div class="fm-terms-card-{{ section.id }}" {{ block.shopify_attributes }}>
              <div class="fm-terms-card-title-{{ section.id }}">{{ block.settings.title }}</div>
              <div class="fm-terms-card-desc-{{ section.id }}">{{ block.settings.description }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    {%- else -%}
<h2 class="fm-terms-h2">Introduction</h2>
    <p class="fm-terms-p">Welcome to Farsh Mahal. These Terms and Conditions govern your access to and use of our website, services, and handcrafted luxury rug collections. By accessing or ordering from Farsh Mahal, you agree to be bound by these terms.</p>

    <h2 class="fm-terms-h2">General conditions</h2>
    <p class="fm-terms-p">We reserve the right to refuse service to anyone for any reason at any time. You understand that your content (not including credit card information) may be transferred unencrypted and involve transmissions over various networks.</p>

    <h2 class="fm-terms-h2">User account, password and security</h2>
    <p class="fm-terms-p">If you create an account on our platform, you are responsible for maintaining the confidentiality of your account credentials and for restricting access to your device.</p>

    <h2 class="fm-terms-h2">Accuracy of billing and other account information</h2>
    <p class="fm-terms-p">You agree to provide current, complete, and accurate purchase and account information for all orders made at our store. You agree to promptly update your contact and billing information so that we can complete your transactions smoothly.</p>

    <h2 class="fm-terms-h2">Order cancellation or limitation of quantities</h2>
    <p class="fm-terms-p">We reserve the right to reject or limit quantities on any order for reasons including inventory availability, pricing discrepancies, or suspicion of fraudulent activity. In such events, we will notify you and promptly refund any charged amounts.</p>

    <h2 class="fm-terms-h2">Order cancellation by customers</h2>
    <p class="fm-terms-p">Orders for standard in-stock rugs may be cancelled within 24 hours of placement if dispatch has not occurred. Custom or made-to-order rugs cannot be cancelled once raw material procurement and artisan loom warping has commenced.</p>

    <h2 class="fm-terms-h2">User comments, feedback, and submissions</h2>
    <p class="fm-terms-p">If you send creative ideas, suggestions, reviews, or design proposals to us, you agree that we may, without restriction, edit, copy, publish, and distribute them in any medium.</p>

    <h2 class="fm-terms-h2">Prohibited uses</h2>
    <p class="fm-terms-p">You are prohibited from using the site or its content for any unlawful purpose, to solicit others to perform unlawful acts, to violate intellectual property rights, or to transmit malicious software.</p>

    <h2 class="fm-terms-h2">Termination of service</h2>
    <p class="fm-terms-p">The obligations and liabilities of the parties incurred prior to the termination date shall survive the termination of this agreement for all purposes.</p>

    <h2 class="fm-terms-h2">Product & pricing</h2>
    <p class="fm-terms-p">Prices for our products are subject to change without notice. We reserve the right at any time to modify or discontinue any collection or piece without notice.</p>

    <h2 class="fm-terms-h2">Intellectual property</h2>
    <p class="fm-terms-p">All rug designs, photography, branding, copy, and visual assets displayed on Farsh Mahal are the exclusive intellectual property of Farsh Mahal and are protected by applicable copyright and design registration laws.</p>

    <h2 class="fm-terms-h2">Additional / optional tools</h2>
    <p class="fm-terms-p">We may provide you with access to third-party tools (such as room visualizers or currency converters) over which we neither monitor nor have any direct control.</p>

    <h2 class="fm-terms-h2">Third-party links</h2>
    <p class="fm-terms-p">Certain content and services available via our store may include materials from third parties. Third-party links on this site may direct you to external websites not affiliated with us.</p>

    <h2 class="fm-terms-h2">Errors, inaccuracies & omissions</h2>
    <p class="fm-terms-p">Occasionally there may be information on our site that contains typographical errors, inaccuracies, or omissions related to product descriptions, pricing, promotions, and availability. We reserve the right to correct any errors without prior notice.</p>

    <h2 class="fm-terms-h2">Periodical updates</h2>
    <p class="fm-terms-p">You can review the most current version of the Terms & Conditions at any time on this page. We reserve the right to update or replace any part of these terms by posting updates directly to our website.</p>

    <h2 class="fm-terms-h2">Contact information</h2>
    <p class="fm-terms-p">Questions regarding these Terms & Conditions should be directed to <a href="mailto:farshmahal@gmail.com" class="fm-terms-link">farshmahal@gmail.com</a>.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FM Terms",
  "tag": "section",
  "class": "section-fm-terms",
  "settings": [
    {
      "type": "header",
      "content": "Page Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Legal"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Terms & Conditions"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Please read these terms carefully — using our services means you accept them."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FBF8F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1B4332"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle / Answer Color",
      "default": "rgba(27, 67, 50, 0.75)"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#C1914E"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border / Divider Color",
      "default": "rgba(27, 67, 50, 0.12)"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_header",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Header Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_header",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Header Padding Bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_body",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Body Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_body",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Body Padding Bottom",
      "default": 100
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Header Container Width",
      "default": 1100
    },
    {
      "type": "range",
      "id": "body_container_width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Body Container Width",
      "default": 900
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Title Font Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "subtitle_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Font Size",
      "default": 15
    },
    {
      "type": "range",
      "id": "body_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Body Font Size",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "heading_block",
      "name": "Heading / Category",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading Text",
          "default": "Section Heading"
        }
      ]
    },
    {
      "type": "qa_block",
      "name": "Q&A / Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question text here"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Answer text goes here."
        }
      ]
    },
    {
      "type": "richtext_block",
      "name": "Rich Text / Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Content goes here.</p>"
        }
      ]
    },
    {
      "type": "card_block",
      "name": "Feature / Benefit Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description",
          "default": "Description of the feature."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FM Terms"
    }
  ]
}
{% endschema %}
