<!-- Load exact Google Fonts for Hero -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,300;1,400;1,500&family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

{%- style -%}
  /* Ken Burns Slow Animation matching farshmahal.com (22s ease-out alternate) */
  @keyframes ken-burns-slow {
    0% { transform: scale(1); }
    100% { transform: scale(1.08); }
  }

  /* Fade Up Animation matching farshmahal.com (1.1s ease-out both) */
  @keyframes fade-up {
    0% {
      opacity: 0;
      transform: translateY(28px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Hero Main Container */
  .fm-live-hero-section {
    position: relative;
    z-index: 1;
    height: 100svh;
    min-height: 720px;
    width: 100%;
    overflow: hidden;
    background-color: #0b1712;
    color: #F7F2ED;
    box-sizing: border-box;
  }

  /* Background Slides with Cross-Fade (1400ms) */
  .fm-live-hero-bg-slide {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0;
    transition: opacity 1400ms cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1;
    overflow: hidden;
  }
  .fm-live-hero-bg-slide.active {
    opacity: 1;
    z-index: 2;
  }
  .fm-live-hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1);
    will-change: transform;
  }
  .fm-live-hero-bg-slide.active .fm-live-hero-bg-img {
    animation: ken-burns-slow 22s ease-out infinite alternate;
  }

  /* Authentic Film Grain Noise Effect from farshmahal.com (.grain:before) */
  .fm-live-hero-grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
  }
  .fm-live-hero-grain:before {
    background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9'/></filter><rect width='200' height='200' filter='url(%23n)' opacity='0.7'/></svg>");
    content: "";
    inset: 0;
    mix-blend-mode: multiply;
    opacity: 0.06;
    pointer-events: none;
    position: absolute;
  }

  /* Dual Cinematic Gradients matching Tailwind from farshmahal.com */
  .fm-live-hero-grad-bottom {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(11, 23, 18, 0.75) 0%, rgba(11, 23, 18, 0.35) 50%, rgba(11, 23, 18, 0.20) 100%);
    pointer-events: none;
    z-index: 3;
  }
  .fm-live-hero-grad-left {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(11, 23, 18, 0.60) 0%, rgba(11, 23, 18, 0.25) 50%, transparent 100%);
    pointer-events: none;
    z-index: 4;
  }

  /* Content Wrapper: max-w-[1500px] justify-end pb-14 md:pb-20 pt-32 md:pt-36 */
  .fm-live-hero-content-wrapper {
    position: relative;
    z-index: 2;
    height: 100%;
    max-width: 1500px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 128px;
    padding-bottom: 56px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-sizing: border-box;
  }

  @media screen and (min-width: 768px) {
    .fm-live-hero-content-wrapper {
      padding-left: 48px;
      padding-right: 48px;
      padding-top: 144px;
      padding-bottom: 80px;
    }
  }

  .fm-live-hero-content-wrapper::before {
    content: "";
    position: absolute;
    left: -50vw;
    right: -50vw;
    bottom: 0;
    height: 55%;
    background: linear-gradient(
      to top,
      rgba(11, 23, 18, 0.88) 0%,
      rgba(11, 23, 18, 0.55) 45%,
      transparent 100%
    );
    pointer-events: none;
    z-index: -1;
  }



  /* Text Slider: max-w-[640px] md:max-w-[720px] */
  .fm-live-hero-text-slide {
    display: none;
    max-width: 640px;
  }
  @media screen and (min-width: 768px) {
    .fm-live-hero-text-slide {
      max-width: 720px;
    }
  }
  .fm-live-hero-text-slide.active {
    display: block;
  }

  /* Staggered Element Reveals */
  .fm-live-hero-text-slide.active .fm-live-hero-eyebrow {
    animation: fade-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
  }
  .fm-live-hero-text-slide.active .fm-live-hero-h1 {
    animation: fade-up 1.0s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }
  .fm-live-hero-text-slide.active .fm-live-hero-sub {
    animation: fade-up 1.0s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }
  .fm-live-hero-text-slide.active .fm-live-hero-cta-wrap {
    animation: fade-up 1.0s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
  }

  /* Eyebrow: text-[11px] tracking-[0.32em] font-sans text-farsh-gold-soft */
  .fm-live-hero-eyebrow {
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 11px !important;
    font-weight: 500 !important;
    letter-spacing: 0.32em !important;
    text-transform: uppercase !important;
    color: #C9A24D !important;
    margin-bottom: 16px;
    display: block;
    line-height: 1.4;
  }
  @media screen and (min-width: 768px) {
    .fm-live-hero-eyebrow {
      margin-bottom: 20px;
    }
  }

  /* H1 Heading: font-editorial text-[42px] leading-[1] sm:text-[52px] md:text-[62px] lg:text-[76px] tracking-[-0.02em] */
  .fm-live-hero-h1 {
    font-family: 'Playfair Display', ui-serif, Georgia, Cambria, serif !important;
    font-weight: 400 !important;
    color: #F7F2ED !important;
    font-size: 42px !important;
    line-height: 1.0 !important;
    letter-spacing: -0.02em !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  @media screen and (min-width: 640px) {
    .fm-live-hero-h1 {
      font-size: 52px !important;
    }
  }
  @media screen and (min-width: 768px) {
    .fm-live-hero-h1 {
      font-size: 62px !important;
    }
  }
  @media screen and (min-width: 1024px) {
    .fm-live-hero-h1 {
      font-size: 76px !important;
    }
  }

  /* Line 2 Italic Accent: italic font-display font-light text-farsh-gold-soft */
  .fm-live-hero-h1-italic {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-style: italic !important;
    font-weight: 300 !important;
    color: #C9A24D !important;
    display: inline-block;
  }

  /* Subtext: max-w-[520px] text-[14px] md:text-[15px] text-farsh-ivory/85 leading-relaxed */
  .fm-live-hero-sub {
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 14px !important;
    line-height: 1.65 !important;
    color: rgba(247, 242, 237, 0.85) !important;
    max-width: 520px !important;
    margin-top: 24px !important;
    margin-bottom: 0 !important;
    font-weight: 300 !important;
  }
  @media screen and (min-width: 768px) {
    .fm-live-hero-sub {
      font-size: 15px !important;
      margin-top: 32px !important;
    }
  }

  /* CTAs Container: mt-8 md:mt-10 flex flex-wrap items-center gap-x-6 gap-y-4 */
  .fm-live-hero-cta-wrap {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 24px;
    row-gap: 16px;
  }
  @media screen and (min-width: 768px) {
    .fm-live-hero-cta-wrap {
      margin-top: 40px;
    }
  }

  /* Primary Button with Interactive Arrow Slide */
  .fm-live-hero-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background-color: #F7F2ED !important;
    color: #1B4332 !important;
    padding: 14px 28px !important;
    text-transform: uppercase !important;
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    letter-spacing: 0.28em !important;
    text-decoration: none !important;
    transition: background-color 0.35s ease, color 0.35s ease !important;
    border: none !important;
    border-radius: 0 !important;
    cursor: pointer;
  }
  @media screen and (min-width: 768px) {
    .fm-live-hero-btn-primary {
      padding: 16px 36px !important;
    }
  }
  .fm-live-hero-btn-primary svg {
    transition: transform 0.3s ease;
  }
  .fm-live-hero-btn-primary:hover {
    background-color: #C9A24D !important;
    color: #1B4332 !important;
  }
  .fm-live-hero-btn-primary:hover svg {
    transform: translateX(4px);
  }

  /* Secondary Link with Smooth Gold Expand Underline (.link-underline) */
  .fm-live-hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    text-transform: uppercase !important;
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 11px !important;
    letter-spacing: 0.28em !important;
    font-weight: 500 !important;
    color: #F7F2ED !important;
    text-decoration: none !important;
    background-image: linear-gradient(#C9A24D, #C9A24D);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
    padding-bottom: 2px;
    transition: background-size 0.4s ease, color 0.3s ease;
  }
  .fm-live-hero-btn-secondary:hover {
    color: #C9A24D !important;
    background-size: 100% 1px;
  }

  /* Slide Indicators */
  .fm-live-hero-indicators {
    margin-top: 40px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  @media screen and (min-width: 768px) {
    .fm-live-hero-indicators {
      margin-top: 56px;
    }
  }
  .fm-live-hero-indicator-btn {
    background: none !important;
    border: none !important;
    padding: 8px 0 !important;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
    outline: none;
  }
  .fm-live-hero-indicator-num {
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 11px !important;
    letter-spacing: 0.24em !important;
    color: rgba(247, 242, 237, 0.5) !important;
    transition: color 0.35s ease;
  }
  .fm-live-hero-indicator-btn.active .fm-live-hero-indicator-num {
    color: #F7F2ED !important;
    font-weight: 600 !important;
  }
  .fm-live-hero-indicator-line {
    height: 1px;
    width: 32px;
    background-color: rgba(247, 242, 237, 0.30);
    transition: width 0.45s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.35s ease;
    display: block;
  }
  .fm-live-hero-indicator-btn.active .fm-live-hero-indicator-line {
    width: 64px;
    background-color: #C9A24D;
  }
{%- endstyle -%}

<section class="fm-live-hero-section" id="FmHeroSlider" data-autoplay-speed="{{ section.settings.autoplay_speed | default: 7 | times: 1000 }}">
  <!-- Background Images Slider with Ken Burns Effect -->
  <div class="fm-live-hero-backgrounds">
    {%- for block in section.blocks -%}
      <div class="fm-live-hero-bg-slide {% if forloop.first %}active{% endif %}" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <img
          src="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 2400 }}{% else %}{{ block.settings.fallback_image_url }}{% endif %}"
          alt="{{ block.settings.line_1 | escape }} {{ block.settings.line_2 | escape }}"
          class="fm-live-hero-bg-img"
          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
        >
      </div>
    {%- endfor -%}
  </div>

  <!-- Dual Gradients Overlay matching live site -->
  <div class="fm-live-hero-grad-bottom"></div>
  <div class="fm-live-hero-grad-left"></div>

  <!-- Authentic Film Grain Noise Texture Overlay -->
  <div class="fm-live-hero-grain"></div>

  <!-- Content Container: Bottom Aligned -->
  <div class="fm-live-hero-content-wrapper">
    <div class="fm-live-hero-text-slider">
      {%- for block in section.blocks -%}
        <div class="fm-live-hero-text-slide {% if forloop.first %}active{% endif %}" data-slide-index="{{ forloop.index0 }}">
          {% if block.settings.eyebrow != blank %}
            <span class="fm-live-hero-eyebrow">{{ block.settings.eyebrow | escape }}</span>
          {% endif %}

          <h1 class="fm-live-hero-h1">
            {{ block.settings.line_1 | escape }}<br>
            <span class="fm-live-hero-h1-italic">{{ block.settings.line_2 | escape }}</span><br>
            {{ block.settings.line_3 | escape }}
          </h1>

          {% if block.settings.subtext != blank %}
            <p class="fm-live-hero-sub">{{ block.settings.subtext | escape }}</p>
          {% endif %}

          <div class="fm-live-hero-cta-wrap">
            {% if block.settings.cta1_label != blank %}
              <a href="{{ block.settings.cta1_link | default: '/collections/all' }}" class="fm-live-hero-btn-primary">
                <span>{{ block.settings.cta1_label | escape }}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 2px;">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            {% endif %}

            {% if block.settings.cta2_label != blank %}
              <a href="{{ block.settings.cta2_link | default: '/blogs/news' }}" class="fm-live-hero-btn-secondary">
                {{ block.settings.cta2_label | escape }}
              </a>
            {% endif %}
          </div>
        </div>
      {%- endfor -%}
    </div>

    <!-- Slide Indicators with Expand Line -->
    <div class="fm-live-hero-indicators">
      {%- for block in section.blocks -%}
        <button type="button" class="fm-live-hero-indicator-btn {% if forloop.first %}active{% endif %}" data-target-slide="{{ forloop.index0 }}" aria-label="Go to Slide {{ forloop.index }}">
          <span class="fm-live-hero-indicator-num">0{{ forloop.index }}</span>
          <span class="fm-live-hero-indicator-line"></span>
        </button>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function() {
    function initHeroSlider() {
      const slider = document.getElementById('FmHeroSlider');
      if (!slider) return;

      const bgSlides = slider.querySelectorAll('.fm-live-hero-bg-slide');
      const textSlides = slider.querySelectorAll('.fm-live-hero-text-slide');
      const indicatorBtns = slider.querySelectorAll('.fm-live-hero-indicator-btn');
      const totalSlides = bgSlides.length;
      if (totalSlides <= 1) return;

      const autoplaySpeed = parseInt(slider.getAttribute('data-autoplay-speed')) || 7000;
      let currentIndex = 0;
      let timer = null;

      function goToSlide(index) {
        currentIndex = (index + totalSlides) % totalSlides;

        bgSlides.forEach(function(slide, i) {
          if (i === currentIndex) {
            slide.classList.add('active');
            const img = slide.querySelector('.fm-live-hero-bg-img');
            if (img) {
              img.style.animation = 'none';
              img.offsetHeight; /* force reflow */
              img.style.animation = 'ken-burns-slow 22s ease-out infinite alternate';
            }
          } else {
            slide.classList.remove('active');
          }
        });

        textSlides.forEach(function(slide, i) {
          if (i === currentIndex) {
            slide.classList.add('active');
          } else {
            slide.classList.remove('active');
          }
        });

        indicatorBtns.forEach(function(btn, i) {
          if (i === currentIndex) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
      }

      function startAutoplay() {
        stopAutoplay();
        timer = setInterval(function() {
          goToSlide(currentIndex + 1);
        }, autoplaySpeed);
      }

      function stopAutoplay() {
        if (timer) clearInterval(timer);
      }

      indicatorBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          const target = parseInt(this.getAttribute('data-target-slide'));
          goToSlide(target);
          startAutoplay();
        });
      });

      slider.addEventListener('mouseenter', stopAutoplay);
      slider.addEventListener('mouseleave', startAutoplay);

      startAutoplay();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroSlider);
    } else {
      initHeroSlider();
    }
  })();
</script>

