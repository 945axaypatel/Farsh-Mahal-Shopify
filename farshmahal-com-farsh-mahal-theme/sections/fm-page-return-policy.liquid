{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

<style>
  .fm-policy-page-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FBF8F4' }};
    color: {{ section.settings.text_color | default: '#1B4332' }};
    min-height: 100vh;
  }
  .fm-policy-header-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_header | default: 60 }}px;
    padding-bottom: {{ section.settings.padding_bottom_header | default: 40 }}px;
    border-bottom: 1px solid {{ section.settings.border_color | default: 'rgba(27, 67, 50, 0.12)' }};
  }
  .fm-policy-header-inner-{{ section.id }} {
    max-width: {{ section.settings.container_width | default: 1100 }}px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: {{ section.settings.header_alignment | default: 'left' }};
  }
  .fm-policy-eyebrow-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color | default: '#1B4332' }};
    font-weight: 500;
  }
  .fm-policy-title-{{ section.id }} {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 5.5vw, {{ section.settings.title_font_size | default: 64 }}px);
    line-height: 1.05;
    color: {{ section.settings.text_color | default: '#1B4332' }};
    letter-spacing: -0.02em;
    margin-top: 16px;
    margin-bottom: 0;
    max-width: 850px;
    font-weight: 400;
  }
  .fm-policy-subtitle-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.subtitle_font_size | default: 15 }}px;
    line-height: 1.65;
    color: {{ section.settings.subtitle_color | default: 'rgba(27, 67, 50, 0.75)' }};
    margin-top: 24px;
    margin-bottom: 0;
    max-width: 680px;
  }
  .fm-policy-body-{{ section.id }} {
    max-width: {{ section.settings.body_container_width | default: 900 }}px;
    margin: 0 auto;
    padding-top: {{ section.settings.padding_top_body | default: 64 }}px;
    padding-bottom: {{ section.settings.padding_bottom_body | default: 100 }}px;
    padding-left: 24px;
    padding-right: 24px;
  }
  .fm-policy-h2-{{ section.id }},
  .fm-policy-cat-title-{{ section.id }} {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(24px, 3vw, 34px);
    color: {{ section.settings.text_color | default: '#1B4332' }};
    line-height: 1.15;
    margin-top: 56px;
    margin-bottom: 20px;
    font-weight: 400;
  }
  .fm-policy-h2-{{ section.id }}:first-of-type,
  .fm-policy-cat-title-{{ section.id }}:first-of-type {
    margin-top: 0;
  }
  .fm-policy-h3-{{ section.id }},
  .fm-policy-subcat-title-{{ section.id }} {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(18px, 2.2vw, 22px);
    color: {{ section.settings.text_color | default: '#1B4332' }};
    line-height: 1.25;
    margin-top: 40px;
    margin-bottom: 14px;
    font-weight: 400;
  }
  .fm-policy-p-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.body_font_size | default: 15 }}px;
    color: {{ section.settings.text_color | default: 'rgba(27, 67, 50, 0.85)' }};
    line-height: 1.75;
    margin-bottom: 16px;
  }
  .fm-policy-ul-{{ section.id }} {
    list-style: disc;
    padding-left: 24px;
    margin-bottom: 24px;
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.body_font_size | default: 15 }}px;
    line-height: 1.8;
    color: {{ section.settings.text_color | default: 'rgba(27, 67, 50, 0.85)' }};
  }
  .fm-policy-ul-{{ section.id }} li {
    margin-bottom: 8px;
  }
  .fm-policy-ul-{{ section.id }} li::marker {
    color: {{ section.settings.accent_color | default: '#C1914E' }};
  }
  .fm-policy-qa-{{ section.id }},
  .fm-policy-item-{{ section.id }} {
    border-top: 1px solid {{ section.settings.border_color | default: 'rgba(27, 67, 50, 0.1)' }};
    padding-top: 24px;
    margin-top: 24px;
  }
  .fm-policy-h2-{{ section.id }} + .fm-policy-qa-{{ section.id }},
  .fm-policy-cat-title-{{ section.id }} + .fm-policy-item-{{ section.id }},
  .fm-policy-h3-{{ section.id }} + .fm-policy-qa-{{ section.id }},
  .fm-policy-subcat-title-{{ section.id }} + .fm-policy-item-{{ section.id }} {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }
  .fm-policy-q-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: {{ section.settings.text_color | default: '#1B4332' }};
    margin-bottom: 12px;
    line-height: 1.4;
  }
  .fm-policy-a-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.body_font_size | default: 15 }}px;
    color: {{ section.settings.subtitle_color | default: 'rgba(27, 67, 50, 0.75)' }};
    line-height: 1.75;
  }
  .fm-policy-link-{{ section.id }} {
    color: {{ section.settings.text_color | default: '#1B4332' }};
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .fm-policy-link-{{ section.id }}:hover {
    color: {{ section.settings.accent_color | default: '#C1914E' }};
  }
  .fm-policy-card-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin: 32px 0 48px 0;
  }
  .fm-policy-card-{{ section.id }} {
    background: #FFFFFF;
    border: 1px solid {{ section.settings.border_color | default: 'rgba(27, 67, 50, 0.1)' }};
    padding: 24px;
    border-radius: 2px;
  }
  .fm-policy-card-title-{{ section.id }} {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 18px;
    color: {{ section.settings.text_color | default: '#1B4332' }};
    margin-bottom: 8px;
  }
  .fm-policy-card-desc-{{ section.id }} {
    font-family: 'Manrope', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: {{ section.settings.subtitle_color | default: 'rgba(27, 67, 50, 0.75)' }};
  }
</style>

<div class="fm-policy-page-{{ section.id }}" data-testid="content-page-fm-policy">
  <header class="fm-policy-header-{{ section.id }}">
    <div class="fm-policy-header-inner-{{ section.id }}">
      <div class="fm-policy-eyebrow-{{ section.id }}">{{ section.settings.eyebrow | default: 'Policy' }}</div>
      <h1 class="fm-policy-title-{{ section.id }}">{{ section.settings.title | default: 'Return Policy' }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="fm-policy-subtitle-{{ section.id }}">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
  </header>

  <div class="fm-policy-body-{{ section.id }}">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading_block' -%}
            <h2 class="fm-policy-h2-{{ section.id }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'qa_block' -%}
            <div class="fm-policy-qa-{{ section.id }}" {{ block.shopify_attributes }}>
              <div class="fm-policy-q-{{ section.id }}">{{ block.settings.question }}</div>
              <div class="fm-policy-a-{{ section.id }}">{{ block.settings.answer }}</div>
            </div>
          {%- when 'richtext_block' -%}
            <div class="fm-policy-p-{{ section.id }}" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>
          {%- when 'card_block' -%}
            <div class="fm-policy-card-{{ section.id }}" {{ block.shopify_attributes }}>
              <div class="fm-policy-card-title-{{ section.id }}">{{ block.settings.title }}</div>
              <div class="fm-policy-card-desc-{{ section.id }}">{{ block.settings.description }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    {%- else -%}
<h2 class="fm-policy-h2">Policy overview</h2>
    <p class="fm-policy-p">We take immense pride in the craftsmanship of every Farsh Mahal rug. If for any reason you are not completely satisfied with your domestic purchase, you may initiate a return within <strong>2 days</strong> of delivery.</p>
    <p class="fm-policy-p">To qualify for a return or exchange, the rug must be unused, unwashed, and returned in its original condition with all packaging, serial number tags, and labels intact.</p>

    <h2 class="fm-policy-h2">Reporting defects</h2>
    <p class="fm-policy-p">In the rare event that a product arrives damaged or with a manufacturing defect, please notify us within <strong>48 hours</strong> of delivery by emailing <a href="mailto:farshmahal@gmail.com" class="fm-policy-link">farshmahal@gmail.com</a> with photographs showing the full rug and close-ups of the issue.</p>

    <h2 class="fm-policy-h2">What isn't considered a defect</h2>
    <p class="fm-policy-p">Because every Farsh Mahal piece is handcrafted by master artisans, natural variations are an authentic hallmark of artisanal creation rather than defects:</p>
    <ul class="fm-policy-ul">
      <li>Minor variations in dimensions (up to ±3%), dye tones, and weave tension.</li>
      <li>Occasional yarn sprouting (trim flush with scissors; never pull).</li>
      <li>Initial fibre shedding during the first few weeks of regular use.</li>
      <li>Temporary packaging fold/roll marks that settle naturally with routine vacuuming.</li>
    </ul>

    <h2 class="fm-policy-h2">Resolution</h2>
    <p class="fm-policy-p">Once your returned rug is received and inspected at our central facility (typically within 3–5 business days):</p>
    <ul class="fm-policy-ul">
      <li><strong>Prepaid Orders:</strong> Refunds are credited back to the original payment method within 5–7 business days.</li>
      <li><strong>Cash on Delivery (India):</strong> Refunds are transferred via direct NEFT/RTGS bank transfer upon receipt of your bank details.</li>
      <li><strong>Store Credit / Exchange:</strong> You can choose immediate store credit with 6 months validity toward another Farsh Mahal piece.</li>
    </ul>

    <h2 class="fm-policy-h2">Important notes</h2>
    <ul class="fm-policy-ul">
      <li><strong>International Orders:</strong> Orders shipped outside India are final sale and non-returnable, except in confirmed cases of manufacturing defect reported within 48 hours.</li>
      <li><strong>Custom & Bespoke Rugs:</strong> Made-to-order and custom sized pieces cannot be returned or cancelled once weaving commences.</li>
    </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FM Return Policy",
  "tag": "section",
  "class": "section-fm-policy",
  "settings": [
    {
      "type": "header",
      "content": "Page Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Policy"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Return Policy"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "How returns, exchanges, and refunds work at Farsh Mahal."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FBF8F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1B4332"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle / Answer Color",
      "default": "rgba(27, 67, 50, 0.75)"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#C1914E"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border / Divider Color",
      "default": "rgba(27, 67, 50, 0.12)"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_header",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Header Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_header",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Header Padding Bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_body",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Body Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_body",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Body Padding Bottom",
      "default": 100
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Header Container Width",
      "default": 1100
    },
    {
      "type": "range",
      "id": "body_container_width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Body Container Width",
      "default": 900
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Title Font Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "subtitle_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Font Size",
      "default": 15
    },
    {
      "type": "range",
      "id": "body_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Body Font Size",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "heading_block",
      "name": "Heading / Category",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading Text",
          "default": "Section Heading"
        }
      ]
    },
    {
      "type": "qa_block",
      "name": "Q&A / Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question text here"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Answer text goes here."
        }
      ]
    },
    {
      "type": "richtext_block",
      "name": "Rich Text / Paragraph",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Content goes here.</p>"
        }
      ]
    },
    {
      "type": "card_block",
      "name": "Feature / Benefit Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description",
          "default": "Description of the feature."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FM Return Policy"
    }
  ]
}
{% endschema %}
