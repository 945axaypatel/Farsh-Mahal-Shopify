            var targetSize = sz.toLowerCase().replace(/\s+/g, '').replace(/×/g, 'x').replace(/ft/g, '');
            return itemSizes.some(function(s) {
              var cleanS = s.toLowerCase().replace(/\s+/g, '').replace(/×/g, 'x').replace(/ft/g, '');
              return cleanS === targetSize || cleanS.indexOf(targetSize) !== -1 || targetSize.indexOf(cleanS) !== -1;
            });
          });
          if (!matchAnySize) return false;
        }

        // 3. Color Filter (Multi-select OR)
        if (activeFilters.color.length > 0) {
          var itemColors = item.colors || [];
          var matchAnyColor = activeFilters.color.some(function(clr) {
            var targetColor = clr.toLowerCase().trim();
            return itemColors.some(function(c) {
              var cLower = c.toLowerCase().trim();
              return cLower === targetColor || cLower.indexOf(targetColor) !== -1 || targetColor.indexOf(cLower) !== -1;
            });
          });
          if (!matchAnyColor) return false;
        }

        return true;
      });

      // Sorting
      if (currentSort === 'newest') {
        filtered.sort(function(a, b) { return b.id - a.id; });
      } else if (currentSort === 'price-low') {
        filtered.sort(function(a, b) { return a.price - b.price; });
      } else if (currentSort === 'price-high') {
        filtered.sort(function(a, b) { return b.price - a.price; });
      } else if (currentSort === 'title-asc') {
        filtered.sort(function(a, b) { return a.title.localeCompare(b.title); });
      }

      if (countEl) {
        countEl.textContent = filtered.length;
      }

      // Dynamic Heading matching farshmahal.com
      var headingEl = document.querySelector('.fm-shop-heading');
      if (headingEl) {
        if (activeFilters.q) {
          headingEl.innerHTML = 'Results for <span class="fm-shop-head-italic">"' + activeFilters.q + '"</span>';
        } else if (activeFilters.size.length > 0) {
          headingEl.innerHTML = 'Rugs in <span class="fm-shop-head-italic">' + activeFilters.size[0] + ' ft</span>';
        } else if (activeFilters.collection.length > 0 && activeFilters.collection[0].toLowerCase() !== 'all') {
          headingEl.innerHTML = 'Shop <span class="fm-shop-head-italic">' + activeFilters.collection[0] + '</span>';
        } else {
          headingEl.innerHTML = 'Shop all <span class="fm-shop-head-italic">rugs.</span>';
        }
      }

      // Clear Color button toggle
      document.querySelectorAll('.fm-shop-clear-color-btn, #clearColorBtn').forEach(function(btn) {
        btn.style.display = activeFilters.color.length > 0 ? 'block' : 'none';
      });

      // Sidebar Clear All button toggle
      var hasAnyActive = Object.values(activeFilters).some(function(arr) { return arr.length > 0; });
      document.querySelectorAll('.fm-shop-clear-all-sidebar, #sidebarClearAllBtn').forEach(function(btn) {
        btn.style.display = hasAnyActive ? 'block' : 'none';
      });

      var html = '';
      if (filtered.length === 0) {
        html = '<div style="grid-column: 1 / -1; text-align: center; padding: 64px 0; color: #738075;">' +
                 '<div style="font-family: \'Playfair Display\', serif; font-size: 24px; color: #1B4332; margin-bottom: 8px;">No rugs match your filters</div>' +
                 '<p>Try adjusting your selection to see more options.</p>' +
                 '<button type="button" class="fm-empty-clear-btn" style="margin-top: 16px; padding: 12px 24px; border: 1px solid #1B4332; background: transparent; color: #1B4332; font-family: \'Manrope\', sans-serif; font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; cursor: pointer;">Clear All Filters</button>' +
               '</div>';
      } else {
        filtered.forEach(function(item) {
          var formattedPrice;
          if (item.price_formatted) {
            formattedPrice = item.price_formatted.replace(/([.,]00)(?![0-9])/, '');
          } else {
            var pNum = parseFloat(item.price);
            var hasDec = (pNum % 1 !== 0);
            formattedPrice = '€' + (isNaN(pNum) ? '0' : pNum.toLocaleString('en-US', {
              minimumFractionDigits: hasDec ? 2 : 0,
              maximumFractionDigits: 2
            }));
          }
          var hoverImgHtml = (item.image2 && item.image2 !== item.image)
            ? '<img src="' + item.image2 + '" alt="' + item.title + '" class="fm-shop-card-img fm-shop-card-img-hover" loading="lazy">'
            : '';

          html += '<a href="' + item.url + '" class="fm-shop-card">' +
                    '<div class="fm-shop-card-media">' +
                      '<img src="' + item.image + '" alt="' + item.title + '" class="fm-shop-card-img fm-shop-card-img-primary" loading="lazy">' +
                      hoverImgHtml +
                      (item.is_new ? '<span class="fm-shop-badge-new">NEW</span>' : '') +
                    '</div>' +
                    '<div class="fm-shop-card-info">' +
                      '<div>' +
                        '<h3 class="fm-shop-card-title">' + item.title + '</h3>' +
                        '<span class="fm-shop-card-series">' + item.series + '</span>' +
                      '</div>' +
                      '<div class="fm-shop-card-price">' + formattedPrice + '</div>' +
                    '</div>' +
                  '</a>';
        });
      }

      grid.innerHTML = html;
      renderActivePills();
    }

    function renderActivePills() {
      var container = document.getElementById('activeFilterPills');
      var badge = document.getElementById('activeFilterBadge');
      if (!container) return;

      var totalActive = activeFilters.collection.length + activeFilters.size.length + activeFilters.color.length;
      if (totalActive === 0) {
        container.style.display = 'none';
        container.innerHTML = '';
        if (badge) badge.style.display = 'none';
        return;
      }

      container.style.display = 'flex';
      if (badge) {
        badge.style.display = 'inline';
        badge.textContent = '(' + totalActive + ')';
      }

      var pillsHtml = '<span style="font-family:\'Manrope\',sans-serif; font-size:10px; letter-spacing:0.24em; text-transform:uppercase; color:#738075; margin-right:4px;">FILTERING:</span>';
      
      activeFilters.collection.forEach(function(c) {
        pillsHtml += '<button type="button" class="fm-shop-filter-pill" data-remove-group="collection" data-remove-val="' + c + '">' +
                       c + ' <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>' +
                     '</button>';
      });

      activeFilters.size.forEach(function(s) {
        pillsHtml += '<button type="button" class="fm-shop-filter-pill" data-remove-group="size" data-remove-val="' + s + '">' +
                       s + ' <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>' +
                     '</button>';
      });

      activeFilters.color.forEach(function(clr) {
        pillsHtml += '<button type="button" class="fm-shop-filter-pill" data-remove-group="color" data-remove-val="' + clr + '">' +
                       clr + ' <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>' +
                     '</button>';
      });

      pillsHtml += '<button type="button" class="fm-shop-filter-pill" id="clearAllPillsBtn" style="background:#1B4332; color:#FFFFFF; border-color:#1B4332;">CLEAR ALL</button>';
      container.innerHTML = pillsHtml;
    }

    function updateSidebarUI() {
      document.querySelectorAll('.fm-shop-filter-item-btn').forEach(function(btn) {
        var group = btn.getAttribute('data-filter-group');
        var val = btn.getAttribute('data-filter-val');
        if (group === 'collection') {
          if (activeFilters.collection.length === 0) {
            if (val === 'all') btn.classList.add('active');
            else btn.classList.remove('active');
          } else {
            var isSelected = activeFilters.collection.some(function(c) { return c.toLowerCase() === val.toLowerCase(); });
            if (isSelected) btn.classList.add('active');
            else btn.classList.remove('active');
          }
        } else if (group === 'size') {
          var isSelectedSize = activeFilters.size.some(function(s) { return s.toLowerCase() === val.toLowerCase(); });
          if (isSelectedSize) btn.classList.add('active');
          else btn.classList.remove('active');
        } else {
          var isSelectedOther = activeFilters[group] && activeFilters[group].some(function(v) { return v.toLowerCase() === val.toLowerCase(); });
          if (isSelectedOther) btn.classList.add('active');
          else btn.classList.remove('active');
        }
      });

      document.querySelectorAll('.fm-shop-color-circle').forEach(function(circle) {
        var val = circle.getAttribute('data-filter-val');
        var isSelectedColor = activeFilters.color.some(function(c) { return c.toLowerCase() === val.toLowerCase(); });
        if (isSelectedColor) {
          circle.classList.add('active');
        } else {
          circle.classList.remove('active');
        }
      });
    }

    // Single Global Event Listener with Event Delegation (No duplicate bindings!)
    document.addEventListener('click', function(e) {
      // 1. Filter Item Button clicked
      var btn = e.target.closest('.fm-shop-filter-item-btn');
      if (btn) {
        var group = btn.getAttribute('data-filter-group');
        var val = btn.getAttribute('data-filter-val');

        if (group === 'collection') {
          if (val === 'all') {
            activeFilters.collection = [];
          } else {
            var idx = activeFilters.collection.findIndex(function(c) { return c.toLowerCase() === val.toLowerCase(); });
            if (idx !== -1) {
              activeFilters.collection.splice(idx, 1);
            } else {
              activeFilters.collection.push(val);
            }
          }
        } else if (group === 'size') {
          var sIdx = activeFilters.size.findIndex(function(s) { return s.toLowerCase() === val.toLowerCase(); });
          if (sIdx !== -1) {
            activeFilters.size.splice(sIdx, 1);
          } else {
            activeFilters.size.push(val);
          }
        }

        updateSidebarUI();
        renderProducts();
        return;
      }

      // 2. Color Swatch Circle clicked
      var circle = e.target.closest('.fm-shop-color-circle');
      if (circle) {
        var cVal = circle.getAttribute('data-filter-val');
        var cIdx = activeFilters.color.findIndex(function(c) { return c.toLowerCase() === cVal.toLowerCase(); });
        if (cIdx !== -1) {
          activeFilters.color.splice(cIdx, 1);
        } else {
          activeFilters.color.push(cVal);
        }
        updateSidebarUI();
        renderProducts();
        return;
      }

      // 3. Clear Color clicked
      var clearColor = e.target.closest('.fm-shop-clear-color-btn') || e.target.closest('#clearColorBtn');
      if (clearColor) {
        activeFilters.color = [];
        updateSidebarUI();
        renderProducts();
        return;
      }

      // 4. Clear All Filters clicked
      var clearAll = e.target.closest('.fm-shop-clear-all-sidebar') || 
                     e.target.closest('#sidebarClearAllBtn') || 
                     e.target.closest('#clearAllPillsBtn') || 
                     e.target.closest('.fm-empty-clear-btn');
      if (clearAll) {
        activeFilters.collection = [];
        activeFilters.size = [];
        activeFilters.color = [];
        updateSidebarUI();
        renderProducts();
        return;
      }

      // 5. Remove Individual Pill clicked
      var removePill = e.target.closest('[data-remove-group]');
      if (removePill) {
        var rGroup = removePill.getAttribute('data-remove-group');
        var rVal = removePill.getAttribute('data-remove-val');
        if (activeFilters[rGroup]) {
          var rIdx = activeFilters[rGroup].findIndex(function(v) { return v.toLowerCase() === rVal.toLowerCase(); });
          if (rIdx !== -1) activeFilters[rGroup].splice(rIdx, 1);
        }
        updateSidebarUI();
        renderProducts();
        return;
      }
    });

    // Sort Dropdown Setup
    var sortToggle = document.getElementById('sortDropdownToggle');
    var sortMenu = document.getElementById('sortDropdownMenu');
    var currentSortLabel = document.getElementById('currentSortLabel');

    if (sortToggle && sortMenu) {
      sortToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        sortMenu.classList.toggle('active');
      });

      document.addEventListener('click', function() {
        sortMenu.classList.remove('active');
      });

      sortMenu.querySelectorAll('.fm-shop-sort-option').forEach(function(opt) {
        opt.addEventListener('click', function() {
          currentSort = opt.getAttribute('data-sort');
          if (currentSortLabel) currentSortLabel.textContent = opt.textContent.toUpperCase();
          sortMenu.querySelectorAll('.fm-shop-sort-option').forEach(function(o) { o.classList.remove('selected'); });
          opt.classList.add('selected');
          renderProducts();
        });
      });
    }

    // Mobile Drawer Setup
    var mobileToggle = document.getElementById('mobileFilterToggle');
    var mobileDrawer = document.getElementById('mobileDrawer');
    var drawerClose = document.getElementById('mobileDrawerClose');
    var drawerBody = document.getElementById('mobileDrawerBody');
    var sidebar = document.getElementById('filterSidebarContainer');

    if (mobileToggle && mobileDrawer && drawerBody && sidebar) {
      mobileToggle.addEventListener('click', function() {
        drawerBody.innerHTML = sidebar.innerHTML;
        mobileDrawer.classList.add('open');
        updateSidebarUI();
      });

      if (drawerClose) {
        drawerClose.addEventListener('click', function() {
          mobileDrawer.classList.remove('open');
        });
      }

      mobileDrawer.addEventListener('click', function(e) {
        if (e.target === mobileDrawer) mobileDrawer.classList.remove('open');
      });
    }

    parseUrlParams();
    updateSidebarUI();
    renderProducts();
  })();
</script>
{%- endif -%}

