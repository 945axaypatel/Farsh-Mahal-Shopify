<!-- Load exact Google Fonts for Shop Page -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,300;1,400;1,500;1,600&family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

{%- style -%}
  .fm-shop-wrapper {
    background-color: {{ section.settings.bg_color | default: '#FBF8F4' }};
    color: {{ section.settings.text_color | default: '#1B4332' }};
    min-height: 100vh;
  }

  /* Header Section */
  .fm-shop-header-section {
    padding-top: {{ section.settings.padding_top | default: 56 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 48 }}px;
    border-bottom: 1px solid rgba(27, 67, 50, 0.10);
    background-color: {{ section.settings.bg_color | default: '#FBF8F4' }};
  }

  .fm-shop-container {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }
  @media screen and (min-width: 768px) {
    .fm-shop-container {
      padding: 0 48px;
    }
  }

  .fm-shop-eyebrow {
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 11px !important;
    font-weight: 500 !important;
    letter-spacing: 0.32em !important;
    text-transform: uppercase !important;
    color: {{ section.settings.accent_gold | default: '#C9A24D' }} !important;
    margin: 0 0 14px 0;
    display: block;
    line-height: 1.4;
  }

  .fm-shop-heading {
    font-family: 'Playfair Display', ui-serif, Georgia, Cambria, serif !important;
    font-size: 44px !important;
    line-height: 1.05 !important;
    letter-spacing: -0.02em !important;
    color: {{ section.settings.text_color | default: '#1B4332' }} !important;
    margin: 0 !important;
    font-weight: 400 !important;
    text-transform: none !important;
  }
  @media screen and (min-width: 768px) {
    .fm-shop-heading {
      font-size: 76px !important;
    }
  }

  .fm-shop-head-italic,
  .fm-shop-heading span,
  .fm-shop-heading .italic,
  .fm-shop-heading .font-display {
    font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif !important;
    font-style: italic !important;
    font-weight: 400 !important;
    font-size: 1.02em !important;
    color: inherit !important;
    letter-spacing: -0.01em !important;
    display: inline !important;
    text-transform: none !important;
    vertical-align: baseline !important;
    line-height: inherit !important;
    position: static !important;
  }

  .fm-shop-subtext {
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 15px !important;
    line-height: 1.6 !important;
    color: rgba(27, 67, 50, 0.75) !important;
    max-width: 672px !important;
    margin-top: 24px !important;
    margin-bottom: 0 !important;
    font-weight: 400 !important;
  }

  /* Sticky Action Bar matching screenshot */
  .fm-shop-sticky-bar {
    position: sticky;
    top: 0;
    z-index: 25;
    background-color: rgba(251, 248, 244, 0.95);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid rgba(27, 67, 50, 0.12);
    border-bottom: 1px solid rgba(27, 67, 50, 0.12);
    padding: 16px 0;
  }

  .fm-shop-bar-flex {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .fm-shop-count {
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 12px !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    color: #738075 !important;
    font-weight: 500 !important;
    line-height: 1 !important;
  }

  .fm-shop-count-desktop {
    display: none;
  }
  @media screen and (min-width: 768px) {
    .fm-shop-count-desktop {
      display: block;
    }
  }

  .fm-shop-mobile-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1px solid rgba(27, 67, 50, 0.18);
    background-color: transparent;
    color: #1B4332;
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 11px !important;
    letter-spacing: 0.24em !important;
    text-transform: uppercase !important;
    font-weight: 500 !important;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  @media screen and (min-width: 768px) {
    .fm-shop-mobile-filter-btn {
      display: none !important;
    }
  }

  /* Sort Controls */
  .fm-shop-sort-wrap {
    position: relative;
    display: inline-block;
  }

  .fm-shop-sort-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1px solid rgba(27, 67, 50, 0.18);
    background-color: transparent;
    color: #1B4332;
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 11px !important;
    letter-spacing: 0.24em !important;
    text-transform: uppercase !important;
    font-weight: 500 !important;
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 0 !important;
  }
  .fm-shop-sort-btn:hover {
    background-color: #F7F2ED;
  }

  .fm-shop-sort-dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    width: 240px;
    background-color: #FBF8F4;
    border: 1px solid rgba(27, 67, 50, 0.15);
    box-shadow: 0 12px 32px rgba(27, 67, 50, 0.08);
    display: none;
    flex-direction: column;
    z-index: 30;
  }
  .fm-shop-sort-dropdown.active {
    display: flex;
  }

  .fm-shop-sort-option {
    text-align: left;
    padding: 12px 20px;
    background: transparent;
    border: none;
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 12px !important;
    letter-spacing: 0.14em !important;
    color: #1B4332;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
    width: 100%;
  }
  .fm-shop-sort-option:hover,
  .fm-shop-sort-option.selected {
    background-color: #F7F2ED;
    color: #C9A24D;
  }

  /* Active Filters Row */
  .fm-shop-active-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-top: 12px;
  }

  .fm-shop-filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background-color: #F7F2ED;
    border: 1px solid rgba(27, 67, 50, 0.15);
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 11px !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    color: #1B4332;
    cursor: pointer;
  }
  .fm-shop-filter-pill:hover {
    color: #C9A24D;
    border-color: #C9A24D;
  }

  /* Main Shop Grid Layout */
  .fm-shop-main-section {
    padding-top: 48px;
    padding-bottom: 96px;
  }

  .fm-shop-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media screen and (min-width: 1024px) {
    .fm-shop-layout-grid {
      grid-template-columns: 280px 1fr;
      gap: 48px;
    }
  }

  /* Filter Sidebar matching screenshot */
  .fm-shop-sidebar {
    display: none;
  }
  @media screen and (min-width: 1024px) {
    .fm-shop-sidebar {
      display: block;
    }
  }

  .fm-shop-filter-group {
    padding-top: 20px;
    border-top: 1px solid rgba(27, 67, 50, 0.12);
    margin-bottom: 24px;
  }
  .fm-shop-filter-group:first-child {
    border-top: none;
    padding-top: 0;
  }

  .fm-shop-filter-title {
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 11px !important;
    letter-spacing: 0.32em !important;
    text-transform: uppercase !important;
    color: #C9A24D !important;
    font-weight: 500 !important;
    margin: 0 0 16px 0;
    display: block;
    line-height: 1.2;
  }

  .fm-shop-filter-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Exact Screenshot Checkbox Button Styling */
  .fm-shop-filter-item-btn {
    background: transparent !important;
    border: none !important;
    padding: 6px 0 !important;
    text-align: left !important;
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 14px !important;
    color: #1B4332 !important;
    cursor: pointer;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    line-height: 1.4;
  }
  .fm-shop-filter-item-btn:hover {
    color: #1B4332 !important;
    opacity: 0.8 !important;
  }
  .fm-shop-filter-item-btn.active {
    color: #1B4332 !important;
    font-weight: 600 !important;
  }

  /* 12px Square Checkbox Box */
  .fm-shop-checkbox-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 12px;
    height: 12px;
    border: 1px solid rgba(27, 67, 50, 0.25);
    background-color: transparent;
    transition: background-color 0.2s ease, border-color 0.2s ease;
    flex-shrink: 0;
    box-sizing: border-box;
  }
  .fm-shop-filter-item-btn:hover .fm-shop-checkbox-box {
    border-color: #1B4332;
  }
  .fm-shop-filter-item-btn.active .fm-shop-checkbox-box {
    border-color: #1B4332;
    background-color: #1B4332;
  }

  /* Color Swatches Grid (5 cols) */
  .fm-shop-color-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-top: 8px;
  }

  .fm-shop-color-circle {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    border: 1px solid rgba(27, 67, 50, 0.18);
    cursor: pointer;
    position: relative;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .fm-shop-color-circle:hover {
    transform: scale(1.1);
    border-color: #1B4332;
  }
  .fm-shop-color-circle.active {
    transform: scale(1.12);
    border-color: #1B4332;
    box-shadow: 0 0 0 2px #FBF8F4, 0 0 0 4px #1B4332;
  }

  .fm-shop-clear-color-btn {
    margin-top: 12px;
    background: transparent;
    border: none;
    font-family: 'Manrope', sans-serif !important;
    font-size: 11px !important;
    letter-spacing: 0.24em !important;
    text-transform: uppercase !important;
    color: #1B4332 !important;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.2s ease;
  }
  .fm-shop-clear-color-btn:hover {
    color: #1B4332 !important;
    opacity: 0.75 !important;
  }

  /* Clear All Filters Button in Sidebar */
  .fm-shop-clear-all-sidebar {
    width: 100%;
    text-align: center;
    padding: 12px;
    margin-top: 24px;
    border: 1px solid #1B4332 !important;
    background: transparent !important;
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 11px !important;
    letter-spacing: 0.24em !important;
    text-transform: uppercase !important;
    color: #1B4332 !important;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .fm-shop-clear-all-sidebar:hover {
    background-color: #1B4332 !important;
    color: #FFFFFF !important;
  }

  /* Product Grid: 2 cols mobile, 3 cols desktop */
  .fm-shop-products-grid {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    column-gap: 20px !important;
    row-gap: 40px !important;
    width: 100% !important;
  }
  @media screen and (min-width: 768px) {
    .fm-shop-products-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      column-gap: 28px !important;
      row-gap: 48px !important;
    }
  }
  @media screen and (min-width: 1024px) {
    .fm-shop-products-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, minmax(0, 1fr)) !important;
      column-gap: 32px !important;
      row-gap: 48px !important;
    }
  }

  /* Product Card */
  .fm-shop-card {
    display: block;
    text-decoration: none !important;
    color: inherit;
    position: relative;
  }

  .fm-shop-card-media {
    position: relative;
    aspect-ratio: 4 / 5;
    background-color: #EDE8DE;
    overflow: hidden;
    margin-bottom: 14px;
    display: block;
    width: 100%;
  }

  .fm-shop-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }
  .fm-shop-card-img-primary {
    opacity: 1;
    z-index: 1;
  }
  .fm-shop-card-img-hover {
    opacity: 0;
    z-index: 2;
  }
  .fm-shop-card:hover .fm-shop-card-img-primary {
    transform: scale(1.04);
  }
  .fm-shop-card:hover .fm-shop-card-img-hover {
    opacity: 1;
    transform: scale(1.04);
  }

  /* Gold NEW Badge */
  .fm-shop-badge-new {
    position: absolute;
    top: 14px;
    left: 14px;
    background-color: #C9A24D;
    color: #1B4332;
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 10px !important;
    font-weight: 700 !important;
    letter-spacing: 0.24em !important;
    text-transform: uppercase !important;
    padding: 4px 10px;
    z-index: 5;
    line-height: 1.2;
  }

  .fm-shop-card-info {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .fm-shop-card-title {
    font-family: 'Playfair Display', ui-serif, Georgia, Cambria, serif !important;
    font-size: 18px !important;
    line-height: 1.2 !important;
    color: #1B4332 !important;
    font-weight: 400 !important;
    margin: 0 !important;
    transition: color 0.3s ease;
  }
  .fm-shop-card:hover .fm-shop-card-title {
    color: #C9A24D !important;
  }

  .fm-shop-card-series {
    font-family: 'Manrope', ui-sans-serif, system-ui, -apple-system, sans-serif !important;
    font-size: 10px !important;
    letter-spacing: 0.24em !important;
    text-transform: uppercase !important;
    color: #C9A24D !important;
    font-weight: 600 !important;
    margin-top: 4px !important;
    line-height: 1.2 !important;
    display: block;
  }

  .fm-shop-card-price {
    font-family: 'Playfair Display', ui-serif, Georgia, Cambria, serif !important;
    font-size: 16px !important;
    letter-spacing: 0.01em !important;
    color: #1B4332 !important;
    font-weight: 400 !important;
    white-space: nowrap;
    margin: 0;
    flex-shrink: 0;
  }

  /* Mobile Drawer */
  .fm-shop-mobile-drawer {
    position: fixed;
    inset: 0;
    background-color: rgba(15, 26, 20, 0.50);
    backdrop-filter: blur(4px);
    z-index: 999;
    display: none;
  }
  .fm-shop-mobile-drawer.open {
    display: block;
  }
  .fm-shop-drawer-content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 320px;
    max-width: 85vw;
    background-color: #FBF8F4;
    padding: 32px 24px;
    overflow-y: auto;
    box-shadow: -10px 0 30px rgba(0,0,0,0.15);
  }
  .fm-shop-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(27, 67, 50, 0.12);
  }
  .fm-shop-drawer-title {
    font-family: 'Playfair Display', serif !important;
    font-size: 20px;
    color: #1B4332;
    margin: 0;
  }
  .fm-shop-drawer-close {
    background: transparent;
    border: none;
    font-size: 20px;
    color: #1B4332;
    cursor: pointer;
  }
{%- endstyle -%}

<!-- Dynamic Shopify Products Output in Liquid -->
<script>
  window.ShopifyStoreProducts = [
    {%- paginate collection.products by 250 -%}
      {%- for product in collection.products -%}
        {
          id: {{ product.id }},
          title: {{ product.title | json }},
          handle: {{ product.handle | json }},
          price: {{ product.price | divided_by: 100.0 }},
          price_formatted: {% capture p_fmt %}{% render 'farsh-price-formatted', price: product.price %}{% endcapture %}{{ p_fmt | strip | json }},
          series: {{ product.vendor | default: product.type | default: 'FARSH MAHAL' | json }},
          image: {% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 1200 | json }}{% else %}null{% endif %},
          image2: {% if product.images.size > 1 %}{{ product.images[1] | image_url: width: 1200 | json }}{% elsif product.featured_image != blank %}{{ product.featured_image | image_url: width: 1200 | json }}{% else %}null{% endif %},
          tags: {{ product.tags | json }},
          type: {{ product.type | json }},
          is_new: {% if product.tags contains 'new' or forloop.first %}true{% else %}false{% endif %},
          url: {{ product.url | json }},
          variants: [
            {%- for variant in product.variants -%}
              {
                id: {{ variant.id }},
                title: {{ variant.title | json }},
                option1: {{ variant.option1 | json }},
                option2: {{ variant.option2 | json }},
                option3: {{ variant.option3 | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    {%- endpaginate -%}
  ];
  window.ShopifyCurrentCollection = {{ collection.title | json }};
  window.ShopifyCurrentHandle = {{ collection.handle | json }};
</script>

{%- if collection.handle != 'all' and collection.handle != blank and collection.handle != 'frontpage' and collection.handle != 'catalog' and template.name != 'page' -%}
  {%- render 'farsh-collection-detail-view' -%}
{%- else -%}
<div class="fm-shop-wrapper" id="FarshShopApp">
  <!-- Header Section -->
  <section class="fm-shop-header-section">
    <div class="fm-shop-container">
      <span class="fm-shop-eyebrow">
        {%- if collection.handle != 'all' and collection.title != blank -%}
          COLLECTION
        {%- else -%}
          {{ section.settings.eyebrow | default: 'SHOP' }}
        {%- endif -%}
      </span>
      <h1 class="fm-shop-heading">
        {%- if collection.handle != 'all' and collection.title != blank -%}
          {{ collection.title }}
        {%- else -%}
          {{ section.settings.heading | default: 'Shop all' }}
          <span class="fm-shop-head-italic">{{ section.settings.heading_italic | default: 'rugs.' }}</span>
        {%- endif -%}
      </h1>
      <p class="fm-shop-subtext">
        {%- if collection.description != blank -%}
          {{ collection.description | strip_html }}
        {%- else -%}
          {{ section.settings.subtext | default: 'Thoughtfully designed hand-tufted rugs for modern American homes. Refine below to find the piece that feels perfectly at home.' }}
        {%- endif -%}
      </p>
    </div>
  </section>

  <!-- Sticky Action Bar (Count + Sort) matching screenshot -->
  <section class="fm-shop-sticky-bar">
    <div class="fm-shop-container">
      <div class="fm-shop-bar-flex">
        <!-- Desktop Pieces Count on Left -->
        <div class="fm-shop-count fm-shop-count-desktop">
          <span id="productCountDisplay">47</span> PIECES
        </div>

        <!-- Mobile Filters Button on Left -->
        <button type="button" class="fm-shop-mobile-filter-btn" id="mobileFilterToggle">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 20a1 1 0 0 0 .553.895l2 1A1 1 0 0 0 14 21v-7a2 2 0 0 1 .517-1.341L21.74 4.67A1 1 0 0 0 21 3H3a1 1 0 0 0-.742 1.67l7.225 7.989A2 2 0 0 1 10 14z"></path>
          </svg>
          <span>Filters</span>
          <span id="activeFilterBadge" style="display:none; color: #C9A24D;"></span>
        </button>

        <!-- Right: Sort Menu Button matching exact screenshot -->
        <div class="fm-shop-sort-wrap">
          <button type="button" class="fm-shop-sort-btn" id="sortDropdownToggle">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="21" x2="14" y1="4" y2="4"></line>
              <line x1="10" x2="3" y1="4" y2="4"></line>
              <line x1="21" x2="12" y1="12" y2="12"></line>
              <line x1="8" x2="3" y1="12" y2="12"></line>
              <line x1="21" x2="16" y1="20" y2="20"></line>
              <line x1="12" x2="3" y1="20" y2="20"></line>
              <line x1="14" x2="14" y1="2" y2="6"></line>
              <line x1="8" x2="8" y1="10" y2="14"></line>
              <line x1="16" x2="16" y1="18" y2="22"></line>
            </svg>
            <span id="currentSortLabel">FEATURED</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>
          <div class="fm-shop-sort-dropdown" id="sortDropdownMenu">
            <button type="button" class="fm-shop-sort-option selected" data-sort="featured">Featured</button>
            <button type="button" class="fm-shop-sort-option" data-sort="newest">Newest</button>
            <button type="button" class="fm-shop-sort-option" data-sort="price-low">Price · Low to High</button>
            <button type="button" class="fm-shop-sort-option" data-sort="price-high">Price · High to Low</button>
            <button type="button" class="fm-shop-sort-option" data-sort="title-asc">A → Z</button>
          </div>
        </div>
      </div>

      <!-- Active Filters Pill Row -->
      <div class="fm-shop-active-filters" id="activeFilterPills" style="display:none;"></div>
    </div>
  </section>

  <!-- Main Shop Layout -->
  <section class="fm-shop-main-section">
    <div class="fm-shop-container">
      <div class="fm-shop-layout-grid">
        <!-- Dynamic Filter Sidebar from Shopify Admin -->
        <aside class="fm-shop-sidebar" id="filterSidebarContainer">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'filter_category' -%}
                  <div class="fm-shop-filter-group" {{ block.shopify_attributes }}>
                    <span class="fm-shop-filter-title">{{ block.settings.title }}</span>
                    <ul class="fm-shop-filter-list">
                      {%- if block.settings.include_all_option -%}
                        <li>
                          <button type="button" class="fm-shop-filter-item-btn active" data-filter-group="{{ block.settings.filter_key }}" data-filter-val="all">
                            <span class="fm-shop-checkbox-box"></span>
                            <span>All</span>
                          </button>
                        </li>
                      {%- endif -%}
                      {%- assign opts = block.settings.options | split: ',' -%}
                      {%- for opt in opts -%}
                        {%- assign clean_opt = opt | strip -%}
                        {%- if clean_opt != blank -%}
                          <li>
                            <button type="button" class="fm-shop-filter-item-btn" data-filter-group="{{ block.settings.filter_key }}" data-filter-val="{{ clean_opt }}">
                              <span class="fm-shop-checkbox-box"></span>
                              <span>
                                {%- if block.settings.filter_key == 'size' -%}
                                  {%- if clean_opt contains 'x' or clean_opt contains 'X' or clean_opt contains '×' -%}
                                    {%- assign clean_size = clean_opt | replace: 'x', ' × ' | replace: 'X', ' × ' | replace: '  ×  ', ' × ' | remove: 'ft' | strip -%}
                                    {{ clean_size }} ft
                                  {%- else -%}
                                    {{ clean_opt }}
                                  {%- endif -%}
                                {%- else -%}
                                  {{ clean_opt }}
                                {%- endif -%}
                              </span>
                            </button>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>

                {%- when 'color_palette' -%}
                  <div class="fm-shop-filter-group" {{ block.shopify_attributes }}>
                    <span class="fm-shop-filter-title">{{ block.settings.title | default: 'Color' }}</span>
                    <div class="fm-shop-color-grid">
                      <button type="button" class="fm-shop-color-circle" style="background:#F1EBDE;" data-filter-group="color" data-filter-val="Ivory" title="Ivory"></button>
                      <button type="button" class="fm-shop-color-circle" style="background:#EAE0CC;" data-filter-group="color" data-filter-val="Cream" title="Cream"></button>
                      <button type="button" class="fm-shop-color-circle" style="background:#D4B896;" data-filter-group="color" data-filter-val="Sand" title="Sand"></button>
                      <button type="button" class="fm-shop-color-circle" style="background:#B7A895;" data-filter-group="color" data-filter-val="Stone" title="Stone"></button>
                      <button type="button" class="fm-shop-color-circle" style="background:#8F8B85;" data-filter-group="color" data-filter-val="Grey" title="Grey"></button>
                      <button type="button" class="fm-shop-color-circle" style="background:#3A3733;" data-filter-group="color" data-filter-val="Charcoal" title="Charcoal"></button>
                      <button type="button" class="fm-shop-color-circle" style="background:#4A5D3F;" data-filter-group="color" data-filter-val="Green" title="Green"></button>
                      <button type="button" class="fm-shop-color-circle" style="background:#4A5A6E;" data-filter-group="color" data-filter-val="Blue" title="Blue"></button>
                      <button type="button" class="fm-shop-color-circle" style="background:#C4923F;" data-filter-group="color" data-filter-val="Ochre" title="Ochre"></button>
                      <button type="button" class="fm-shop-color-circle" style="background:#C9A24D;" data-filter-group="color" data-filter-val="Gold" title="Gold"></button>
                      <button type="button" class="fm-shop-color-circle" style="background:#B5623A;" data-filter-group="color" data-filter-val="Terracotta" title="Terracotta"></button>
                      <button type="button" class="fm-shop-color-circle" style="background:#D4A79A;" data-filter-group="color" data-filter-val="Blush" title="Blush"></button>
                      <button type="button" class="fm-shop-color-circle" style="background:#F4EEE2;" data-filter-group="color" data-filter-val="Warm White" title="Warm White"></button>
                    </div>
                    <button type="button" class="fm-shop-clear-color-btn" id="clearColorBtn" style="display:none;">Clear color</button>
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          {%- endif -%}

          <!-- Clear All Filters button -->
          <button type="button" class="fm-shop-clear-all-sidebar" id="sidebarClearAllBtn" style="display:none;">Clear All Filters</button>
        </aside>

        <!-- Product Grid Column -->
        <div class="fm-shop-products-container">
          <div class="fm-shop-products-grid" id="productGridEl">
            <!-- Dynamically loaded via JavaScript & Shopify Store DB -->
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mobile Drawer for Filters -->
  <div class="fm-shop-mobile-drawer" id="mobileDrawer">
    <div class="fm-shop-drawer-content">
      <div class="fm-shop-drawer-header">
        <h3 class="fm-shop-drawer-title">Filters</h3>
        <button type="button" class="fm-shop-drawer-close" id="mobileDrawerClose">✕</button>
      </div>
      <div id="mobileDrawerBody">
        <!-- Cloned filters -->
      </div>
    </div>
  </div>
</div>

